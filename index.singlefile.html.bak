<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#060709">
  <meta name="description" content="AWAKEN — Premium Multi-Mode Minimalist Screensaver & OLED Display Care System">
  <title>AWAKEN — Premium Ambient Screensaver</title>
  
  <style>
    /* ==========================================================================
       1. DESIGN SYSTEM & CSS VARIABLES
       ========================================================================== */
    :root {
      --bg-void: #000000;
      --bg-obsidian: #060709;
      --bg-surface: rgba(18, 22, 31, 0.72);
      --bg-surface-hover: rgba(28, 34, 48, 0.85);
      --bg-glass: rgba(14, 18, 27, 0.65);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-accent: rgba(56, 189, 248, 0.35);
      --border-active: rgba(56, 189, 248, 0.8);
      
      --accent-cyan: #38bdf8;
      --accent-cyan-glow: rgba(56, 189, 248, 0.25);
      --accent-amber: #f59e0b;
      --accent-emerald: #10b981;
      --accent-rose: #f43f5e;
      --accent-purple: #a855f7;
      
      --text-pure: #ffffff;
      --text-primary: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --text-dim: #334155;
      
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
      
      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.4);
      --shadow-md: 0 8px 32px rgba(0, 0, 0, 0.6);
      --shadow-glow: 0 0 30px rgba(56, 189, 248, 0.15);
      
      --font-stack: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      --font-mono: "SF Mono", "Fira Code", "Courier New", monospace;
      
      --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
      --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      --transition-smooth: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      
      --screensaver-brightness: 1.0;
      --clock-opacity: 0.45;
    }

    /* ==========================================================================
       2. RESET & BASE STYLES
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    html, body {
      width: 100%;
      height: 100%;
      background-color: var(--bg-obsidian);
      color: var(--text-primary);
      font-family: var(--font-stack);
      overflow-x: hidden;
      user-select: none;
      -webkit-user-select: none;
    }

    body.screensaver-active {
      overflow: hidden;
    }

    body.screensaver-active.hide-cursor {
      cursor: none !important;
    }

    body.screensaver-active.hide-cursor * {
      cursor: none !important;
    }

    button {
      background: none;
      border: none;
      color: inherit;
      font: inherit;
      cursor: pointer;
      outline: none;
    }

    input, select {
      font: inherit;
      color: inherit;
      outline: none;
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: var(--bg-obsidian);
    }
    ::-webkit-scrollbar-thumb {
      background: var(--border-subtle);
      border-radius: var(--radius-full);
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--text-dim);
    }

    /* ==========================================================================
       3. DASHBOARD / HOME UI
       ========================================================================== */
    #dashboard-view {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 10;
      background: radial-gradient(circle at 50% 0%, rgba(24, 32, 47, 0.5) 0%, var(--bg-obsidian) 70%);
      transition: opacity var(--transition-normal);
    }

    .dashboard-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 24px 36px;
      border-bottom: 1px solid var(--border-subtle);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(6, 7, 9, 0.85);
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-logo-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, #1e293b, #0f172a);
      border: 1px solid var(--border-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-glow);
    }

    .brand-logo-icon svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: var(--accent-cyan);
      stroke-width: 1.8;
    }

    .brand-text h1 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-pure);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-text h1 span.badge-pro {
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      background: rgba(56, 189, 248, 0.15);
      color: var(--accent-cyan);
      border: 1px solid var(--border-accent);
      padding: 2px 6px;
      border-radius: var(--radius-sm);
    }

    .brand-text p {
      font-size: 0.78rem;
      color: var(--text-secondary);
      letter-spacing: 0.02em;
      margin-top: 1px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      font-size: 0.76rem;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      transition: var(--transition-fast);
    }

    .status-pill.clickable {
      cursor: pointer;
    }

    .status-pill.clickable:hover {
      border-color: var(--border-accent);
      color: var(--text-primary);
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--text-muted);
      transition: background var(--transition-fast), box-shadow var(--transition-fast);
    }

    .status-dot.active {
      background: var(--accent-emerald);
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.6);
    }

    .status-dot.blocked {
      background: var(--accent-amber);
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      transition: var(--transition-fast);
    }

    .icon-btn:hover {
      background: var(--bg-surface-hover);
      border-color: var(--border-accent);
      color: var(--text-pure);
    }

    .icon-btn svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .primary-start-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 9px 22px;
      background: linear-gradient(135deg, #0284c7, #0369a1);
      border: 1px solid var(--border-accent);
      border-radius: var(--radius-sm);
      color: var(--text-pure);
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      box-shadow: var(--shadow-glow);
      transition: var(--transition-fast);
    }

    .primary-start-btn:hover {
      background: linear-gradient(135deg, #38bdf8, #0284c7);
      transform: translateY(-1px);
      box-shadow: 0 0 25px rgba(56, 189, 248, 0.4);
    }

    .primary-start-btn svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }

    /* Hero / Banner */
    .dashboard-hero {
      padding: 44px 36px 20px;
      max-width: 1380px;
      margin: 0 auto;
      width: 100%;
    }

    .hero-top-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 32px;
    }

    .hero-title-area h2 {
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text-pure);
      line-height: 1.2;
    }

    .hero-title-area p {
      font-size: 0.95rem;
      color: var(--text-secondary);
      margin-top: 6px;
      max-width: 580px;
      line-height: 1.5;
    }

    .hero-quick-stats {
      display: flex;
      gap: 16px;
    }

    .stat-badge {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      padding: 10px 18px;
      border-radius: var(--radius-md);
      text-align: right;
    }

    .stat-label {
      font-size: 0.68rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-family: var(--font-mono);
    }

    .stat-val {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-top: 2px;
    }

    /* Filter / Mode Bar */
    .mode-filter-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 16px;
      margin-bottom: 24px;
    }

    .filter-tabs {
      display: flex;
      gap: 8px;
    }

    .filter-tab {
      padding: 6px 14px;
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--text-secondary);
      border: 1px solid transparent;
      transition: var(--transition-fast);
    }

    .filter-tab:hover {
      color: var(--text-primary);
      background: var(--bg-surface);
    }

    .filter-tab.active {
      color: var(--accent-cyan);
      background: rgba(56, 189, 248, 0.1);
      border-color: var(--border-accent);
    }

    .filter-info-hint {
      font-size: 0.78rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* ==========================================================================
       4. SCREENSAWER MODES GRID & CARDS
       ========================================================================== */
    .modes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 24px;
      max-width: 1380px;
      margin: 0 auto 60px;
      padding: 0 36px;
      width: 100%;
    }

    .mode-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
      cursor: pointer;
      transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .mode-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 255, 255, 0.2);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    }

    .mode-card.selected {
      border-color: var(--border-active);
      box-shadow: 0 0 28px rgba(56, 189, 248, 0.2), inset 0 0 0 1px var(--accent-cyan);
    }

    .card-thumbnail {
      width: 100%;
      height: 185px;
      position: relative;
      overflow: hidden;
      background: #020305;
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid var(--border-subtle);
    }

    .card-thumbnail-preview {
      width: 100%;
      height: 100%;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .card-badge-tier {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 5;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .tier-ultra-low {
      background: rgba(16, 185, 129, 0.2);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.35);
    }

    .tier-cinematic {
      background: rgba(56, 189, 248, 0.2);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.35);
    }

    .tier-relaxing {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.35);
    }

    .tier-abstract {
      background: rgba(168, 85, 247, 0.2);
      color: #c084fc;
      border: 1px solid rgba(168, 85, 247, 0.35);
    }

    .card-selection-check {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 5;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(6, 7, 9, 0.85);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      color: transparent;
      transition: var(--transition-fast);
    }

    .mode-card.selected .card-selection-check {
      background: var(--accent-cyan);
      border-color: var(--accent-cyan);
      color: #000;
    }

    .card-selection-check svg {
      width: 14px;
      height: 14px;
      stroke-width: 2.5;
    }

    .card-body {
      padding: 18px 20px 20px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .card-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 6px;
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-pure);
      letter-spacing: -0.01em;
    }

    .card-mode-num {
      font-size: 0.72rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
    }

    .card-desc {
      font-size: 0.82rem;
      color: var(--text-secondary);
      line-height: 1.48;
      margin-bottom: 16px;
      flex-grow: 1;
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border-subtle);
      padding-top: 12px;
      font-size: 0.74rem;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    .card-resource-meter {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .meter-bar {
      width: 38px;
      height: 4px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.1);
      overflow: hidden;
      position: relative;
    }

    .meter-fill {
      height: 100%;
      border-radius: 2px;
    }

    .meter-fill.low {
      width: 15%;
      background: var(--accent-emerald);
    }
    .meter-fill.med {
      width: 45%;
      background: var(--accent-cyan);
    }
    .meter-fill.cinematic {
      width: 75%;
      background: var(--accent-amber);
    }

    .card-launch-action {
      display: flex;
      align-items: center;
      gap: 4px;
      color: var(--text-secondary);
      font-weight: 600;
      transition: var(--transition-fast);
    }

    .mode-card:hover .card-launch-action {
      color: var(--accent-cyan);
    }

    /* ==========================================================================
       5. KEYBOARD SHORTCUTS DOCK & FOOTER
       ========================================================================== */
    .shortcuts-section {
      max-width: 1380px;
      margin: 0 auto 40px;
      padding: 0 36px;
      width: 100%;
    }

    .shortcuts-container {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .shortcuts-title {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .shortcut-chips {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .shortcut-chip {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    kbd {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 4px;
      padding: 2px 7px;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-primary);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .dashboard-footer {
      margin-top: auto;
      border-top: 1px solid var(--border-subtle);
      padding: 24px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.78rem;
      color: var(--text-muted);
      flex-wrap: wrap;
      gap: 12px;
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* ==========================================================================
       6. SETTINGS MODAL
       ========================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-normal);
      padding: 20px;
    }

    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-window {
      background: #0d111a;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 620px;
      max-height: 85vh;
      overflow-y: auto;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8), 0 0 0 1px var(--border-subtle);
      transform: translateY(16px) scale(0.98);
      transition: transform var(--transition-normal);
    }

    .modal-backdrop.open .modal-window {
      transform: translateY(0) scale(1);
    }

    .modal-header {
      padding: 22px 28px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      background: #0d111a;
      z-index: 10;
    }

    .modal-header h3 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-pure);
    }

    .modal-content {
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 26px;
    }

    .settings-group {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .settings-group-title {
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent-cyan);
      font-family: var(--font-mono);
      margin-bottom: 2px;
    }

    .setting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .setting-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .setting-label {
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-primary);
    }

    .setting-hint {
      font-size: 0.75rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Toggle Switch */
    .switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
      flex-shrink: 0;
    }

    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .switch-slider {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background-color: rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-full);
      transition: var(--transition-fast);
      border: 1px solid var(--border-subtle);
    }

    .switch-slider:before {
      position: absolute;
      content: "";
      height: 16px;
      width: 16px;
      left: 3px;
      bottom: 3px;
      background-color: var(--text-muted);
      border-radius: 50%;
      transition: var(--transition-fast);
    }

    .switch input:checked + .switch-slider {
      background-color: rgba(56, 189, 248, 0.25);
      border-color: var(--accent-cyan);
    }

    .switch input:checked + .switch-slider:before {
      transform: translateX(20px);
      background-color: var(--accent-cyan);
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
    }

    /* Range Sliders */
    .range-control {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 180px;
    }

    .range-slider {
      -webkit-appearance: none;
      width: 100%;
      height: 5px;
      border-radius: 3px;
      background: rgba(255, 255, 255, 0.15);
      outline: none;
    }

    .range-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--accent-cyan);
      cursor: pointer;
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
      transition: transform var(--transition-fast);
    }

    .range-slider::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }

    .range-val {
      font-size: 0.76rem;
      font-family: var(--font-mono);
      color: var(--text-secondary);
      min-width: 36px;
      text-align: right;
    }

    /* Dropdown select */
    .custom-select {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 6px 12px;
      font-size: 0.82rem;
      color: var(--text-primary);
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .custom-select:hover, .custom-select:focus {
      border-color: var(--border-accent);
    }

    .modal-footer {
      padding: 20px 28px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #0d111a;
      position: sticky;
      bottom: 0;
    }

    .btn-secondary {
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      font-size: 0.82rem;
      color: var(--text-secondary);
      transition: var(--transition-fast);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-pure);
    }

    /* ==========================================================================
       7. ACTIVE SCREENSAWER VIEWPORT & CONTROLS OVERLAY
       ========================================================================== */
    #screensaver-viewport {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      background-color: var(--bg-void);
      z-index: 9999;
      display: none;
      overflow: hidden;
    }

    #screensaver-viewport.active {
      display: block;
    }

    /* Brightness / Dimmer Screen Overlay */
    #screensaver-dimmer {
      position: absolute;
      inset: 0;
      background: #000000;
      pointer-events: none;
      z-index: 500;
      opacity: 0;
      transition: opacity var(--transition-normal);
    }

    /* OLED Burn-In Safe Container for Clock */
    #screensaver-clock-container {
      position: absolute;
      z-index: 600;
      pointer-events: none;
      transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1), opacity var(--transition-normal);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: rgba(255, 255, 255, var(--clock-opacity));
      text-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
    }

    /* Minimalist HUD Clock Typography */
    .hud-time {
      font-size: 3.8rem;
      font-weight: 200;
      letter-spacing: -0.02em;
      line-height: 1;
      font-feature-settings: "tnum";
      font-variant-numeric: tabular-nums;
    }

    .hud-time .hud-seconds {
      font-size: 1.4rem;
      font-weight: 300;
      margin-left: 4px;
      opacity: 0.65;
    }

    .hud-date {
      font-size: 0.85rem;
      font-weight: 400;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-top: 8px;
      opacity: 0.75;
    }

    /* Mode 1 Specific Ultra-Dim Minimal Readout */
    #mode-minimal.active-scene + #screensaver-clock-container {
      /* Mode 1 handles its own positioned tiny dim readout */
      display: none !important;
    }

    /* Floating HUD Dock (Appears on Mousemove / Tap) */
    #screensaver-hud {
      position: absolute;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%) translateY(0);
      z-index: 700;
      background: rgba(14, 18, 27, 0.75);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      padding: 10px 22px;
      display: flex;
      align-items: center;
      gap: 18px;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-normal), transform var(--transition-normal);
    }

    #screensaver-hud.visible {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }

    .hud-mode-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-pure);
      border-right: 1px solid var(--border-subtle);
      padding-right: 16px;
    }

    .hud-nav-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-secondary);
      transition: var(--transition-fast);
    }

    .hud-nav-btn:hover {
      background: rgba(255, 255, 255, 0.15);
      color: var(--text-pure);
    }

    .hud-nav-btn svg {
      width: 14px;
      height: 14px;
      stroke-width: 2.2;
    }

    .hud-controls-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .hud-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 0.76rem;
      transition: var(--transition-fast);
    }

    .hud-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      color: var(--text-pure);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .hud-btn.active {
      color: var(--accent-cyan);
      border-color: var(--border-accent);
      background: rgba(56, 189, 248, 0.12);
    }

    .hud-btn svg {
      width: 14px;
      height: 14px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
    }

    .hud-exit-btn {
      background: rgba(244, 63, 94, 0.15);
      border-color: rgba(244, 63, 94, 0.35);
      color: #fda4af;
      font-weight: 600;
    }

    .hud-exit-btn:hover {
      background: rgba(244, 63, 94, 0.3);
      color: #fff;
      border-color: var(--accent-rose);
    }

    /* In-Screensaver Brightness Bar in HUD */
    .hud-brightness-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-left: 6px;
      border-left: 1px solid var(--border-subtle);
    }

    .hud-brightness-slider {
      width: 70px;
      height: 4px;
      -webkit-appearance: none;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.18);
    }

    .hud-brightness-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--text-pure);
      cursor: pointer;
    }

    /* Pause Indicator Banner */
    #screensaver-pause-badge {
      position: absolute;
      top: 32px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 750;
      padding: 6px 16px;
      background: rgba(14, 18, 27, 0.85);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--text-secondary);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-family: var(--font-mono);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-fast);
    }

    #screensaver-pause-badge.visible {
      opacity: 1;
    }

    /* ==========================================================================
       8. SCENE CONTAINERS
       ========================================================================== */
    .screensaver-scene {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: none;
      overflow: hidden;
    }

    .screensaver-scene.active-scene {
      display: block;
    }

    /* ==========================================================================
       MODE 1: ABSOLUTE MINIMAL (ULTRA LOW RESOURCE)
       ========================================================================== */
    #mode-minimal {
      background: #000000;
    }

    #mode-minimal-display {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: rgba(255, 255, 255, var(--clock-opacity));
      transition: top 3s ease, left 3s ease, right 3s ease, bottom 3s ease;
      font-family: var(--font-stack);
      pointer-events: none;
    }

    .minimal-time {
      font-size: 2.2rem;
      font-weight: 300;
      letter-spacing: 0.04em;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }

    .minimal-date {
      font-size: 0.68rem;
      font-weight: 400;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-top: 6px;
      opacity: 0.6;
    }

    /* ==========================================================================
       MODE 2: AUTONOMOUS NIGHT DRIVE (CINEMATIC)
       ========================================================================== */
    #mode-drive {
      background: #030611;
      perspective: 700px;
    }

    .drive-sky {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 52%;
      background: linear-gradient(180deg, #020409 0%, #050b1a 60%, #0a1733 100%);
      overflow: hidden;
    }

    .drive-stars {
      position: absolute;
      inset: 0;
      background-image: 
        radial-gradient(1px 1px at 15% 25%, rgba(255,255,255,0.7) 1px, transparent 0),
        radial-gradient(1px 1px at 35% 15%, rgba(255,255,255,0.5) 1px, transparent 0),
        radial-gradient(1.5px 1.5px at 60% 30%, rgba(255,255,255,0.8) 1.5px, transparent 0),
        radial-gradient(1px 1px at 80% 18%, rgba(255,255,255,0.6) 1px, transparent 0),
        radial-gradient(1px 1px at 92% 40%, rgba(255,255,255,0.5) 1px, transparent 0);
    }

    .drive-horizon-glow {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 80px;
      background: radial-gradient(ellipse at 50% 100%, rgba(56, 189, 248, 0.18) 0%, rgba(14, 25, 48, 0.4) 50%, transparent 80%);
    }

    .drive-city-silhouette {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 45px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 3px;
      opacity: 0.35;
    }

    .drive-bldg {
      background: #050a14;
      flex-shrink: 0;
    }

    /* 3D Road Surface */
    .drive-road-container {
      position: absolute;
      bottom: -40px;
      left: 50%;
      transform: translateX(-50%) rotateX(68deg);
      width: 900px;
      height: 1200px;
      background: linear-gradient(180deg, #090e18 0%, #0c121e 70%, #111a2c 100%);
      transform-origin: 50% 100%;
      box-shadow: 0 0 100px rgba(0, 0, 0, 0.95);
      border-left: 6px solid #24324d;
      border-right: 6px solid #24324d;
      overflow: hidden;
    }

    .drive-road-lines {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 12px;
      height: 200%;
      background: repeating-linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.85) 0px,
        rgba(255, 255, 255, 0.85) 60px,
        transparent 60px,
        transparent 140px
      );
      animation: roadDash 0.85s linear infinite;
    }

    @keyframes roadDash {
      0% { transform: translateX(-50%) translateY(0); }
      100% { transform: translateX(-50%) translateY(140px); }
    }

    .drive-road-edge-left, .drive-road-edge-right {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 4px;
      background: rgba(255, 255, 255, 0.4);
    }
    .drive-road-edge-left { left: 40px; }
    .drive-road-edge-right { right: 40px; }

    /* Road Headlight Beam Projection */
    .drive-headlight-cone {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 700px;
      background: radial-gradient(ellipse at 50% 100%, rgba(254, 243, 199, 0.18) 0%, rgba(254, 240, 138, 0.05) 50%, transparent 80%);
      pointer-events: none;
    }

    /* Passing Streetlights */
    .drive-streetlights-left, .drive-streetlights-right {
      position: absolute;
      top: 48%;
      height: 48%;
      width: 50%;
      pointer-events: none;
      overflow: hidden;
    }
    .drive-streetlights-left { left: 0; }
    .drive-streetlights-right { right: 0; }

    .drive-light-pole {
      position: absolute;
      top: 0;
      width: 4px;
      height: 80px;
      background: #1e293b;
      opacity: 0;
    }

    .drive-light-pole::after {
      content: "";
      position: absolute;
      top: 0;
      left: -8px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #fef08a;
      box-shadow: 0 0 20px #facc15;
    }

    .drive-light-pole.left {
      left: 36%;
      animation: streetLightPassLeft 3.2s linear infinite;
    }
    .drive-light-pole.right {
      right: 36%;
      animation: streetLightPassRight 3.2s linear infinite 1.6s;
    }

    @keyframes streetLightPassLeft {
      0% {
        top: 0;
        left: 45%;
        transform: scale(0.1);
        opacity: 0;
      }
      20% { opacity: 0.8; }
      100% {
        top: 100%;
        left: 5%;
        transform: scale(1.6);
        opacity: 0.9;
      }
    }

    @keyframes streetLightPassRight {
      0% {
        top: 0;
        right: 45%;
        transform: scale(0.1);
        opacity: 0;
      }
      20% { opacity: 0.8; }
      100% {
        top: 100%;
        right: 5%;
        transform: scale(1.6);
        opacity: 0.9;
      }
    }

    /* Autonomous Vehicle Silhouette */
    .drive-car-silhouette {
      position: absolute;
      bottom: 60px;
      left: 50%;
      transform: translateX(-50%);
      width: 140px;
      height: 80px;
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: carChassisBob 1.6s ease-in-out infinite alternate;
    }

    @keyframes carChassisBob {
      0% { transform: translateX(-50%) translateY(0); }
      100% { transform: translateX(-50%) translateY(-2.5px); }
    }

    .car-cabin {
      width: 78px;
      height: 34px;
      background: #070b14;
      border-top-left-radius: 18px;
      border-top-right-radius: 18px;
      position: relative;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .car-rear-windshield {
      width: 62px;
      height: 22px;
      background: #03060c;
      margin: 4px auto 0;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
    }

    .car-rear-windshield::after {
      content: "";
      position: absolute;
      top: 6px;
      left: 50%;
      transform: translateX(-50%);
      width: 24px;
      height: 2px;
      background: rgba(244, 63, 94, 0.8);
      box-shadow: 0 0 8px rgba(244, 63, 94, 0.8);
    }

    .car-bodywork {
      width: 130px;
      height: 38px;
      background: #090e1a;
      border-radius: 10px;
      position: relative;
      margin-top: -2px;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.85);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 10px;
    }

    .car-taillight {
      width: 24px;
      height: 7px;
      border-radius: 3px;
      background: #e11d48;
      box-shadow: 0 0 14px rgba(225, 29, 72, 0.9), 0 0 28px rgba(225, 29, 72, 0.4);
    }

    .car-exhaust-glow {
      position: absolute;
      bottom: 2px;
      left: 50%;
      transform: translateX(-50%);
      width: 20px;
      height: 3px;
      background: rgba(245, 158, 11, 0.4);
      border-radius: 2px;
    }

    /* ==========================================================================
       MODE 3: COZY RAINY WINDOW (RELAXING)
       ========================================================================== */
    #mode-rain {
      background: #020408;
    }

    .rain-city-backdrop {
      position: absolute;
      inset: -20px;
      filter: blur(28px);
      -webkit-filter: blur(28px);
      background: radial-gradient(circle at 20% 35%, rgba(245, 158, 11, 0.45) 0%, transparent 35%),
                  radial-gradient(circle at 75% 25%, rgba(56, 189, 248, 0.35) 0%, transparent 40%),
                  radial-gradient(circle at 50% 65%, rgba(225, 29, 72, 0.3) 0%, transparent 45%),
                  radial-gradient(circle at 85% 75%, rgba(251, 191, 36, 0.35) 0%, transparent 35%),
                  #070b14;
      opacity: 0.8;
      transform: scale(1.05);
    }

    /* Subtle distant lightning flash */
    .rain-lightning-overlay {
      position: absolute;
      inset: 0;
      background: rgba(224, 242, 254, 0.45);
      opacity: 0;
      pointer-events: none;
      z-index: 10;
      transition: opacity 0.08s ease;
    }

    /* Rain droplets canvas */
    #rain-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 20;
      pointer-events: none;
    }

    /* Cozy Window Sill Foreground Overlay */
    .rain-window-frame {
      position: absolute;
      inset: 0;
      z-index: 30;
      pointer-events: none;
      box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.85);
      border-bottom: 70px solid #080a0f;
    }

    .rain-window-sill {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 70px;
      background: linear-gradient(180deg, #0e121a 0%, #06080d 100%);
      border-top: 2px solid rgba(255, 255, 255, 0.08);
      z-index: 40;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      padding: 0 80px 10px;
    }

    /* Candle with animated flicker */
    .sill-candle-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .candle-glass {
      width: 32px;
      height: 40px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 4px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .candle-wax {
      width: 22px;
      height: 24px;
      background: #fef3c7;
      border-radius: 2px;
      position: absolute;
      bottom: 2px;
    }

    .candle-flame {
      width: 10px;
      height: 16px;
      background: radial-gradient(ellipse at 50% 80%, #fef08a 0%, #f59e0b 60%, transparent 90%);
      border-radius: 50% 50% 30% 30% / 60% 60% 40% 40%;
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      box-shadow: 0 0 16px rgba(245, 158, 11, 0.8), 0 0 35px rgba(245, 158, 11, 0.4);
      animation: candleFlicker 1.4s infinite alternate ease-in-out;
    }

    @keyframes candleFlicker {
      0% { transform: translateX(-50%) scale(1) rotate(-1deg); opacity: 0.95; }
      50% { transform: translateX(-52%) scale(1.08, 0.95) rotate(2deg); opacity: 1; }
      100% { transform: translateX(-48%) scale(0.96, 1.05) rotate(-2deg); opacity: 0.9; }
    }

    /* Steaming Coffee Mug */
    .sill-mug-group {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .mug-cup {
      width: 28px;
      height: 24px;
      background: #1e293b;
      border-radius: 2px 2px 6px 6px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      position: relative;
    }

    .mug-handle {
      position: absolute;
      right: -8px;
      top: 4px;
      width: 8px;
      height: 14px;
      border: 2px solid #1e293b;
      border-left: none;
      border-radius: 0 6px 6px 0;
    }

    .mug-steam {
      position: absolute;
      top: -16px;
      left: 50%;
      transform: translateX(-50%);
      width: 12px;
      height: 16px;
      opacity: 0.35;
      background: radial-gradient(ellipse at center, rgba(255,255,255,0.8), transparent 70%);
      filter: blur(2px);
      animation: steamRise 2.8s infinite linear;
    }

    @keyframes steamRise {
      0% { transform: translateX(-50%) translateY(0) scale(0.8); opacity: 0.4; }
      50% { transform: translateX(-40%) translateY(-8px) scale(1.2); opacity: 0.2; }
      100% { transform: translateX(-60%) translateY(-18px) scale(1.5); opacity: 0; }
    }

    /* Sleeping Cat Silhouette */
    .sill-cat-silhouette {
      width: 60px;
      height: 26px;
      position: relative;
      opacity: 0.85;
      animation: catBreathing 3.6s ease-in-out infinite alternate;
    }

    @keyframes catBreathing {
      0% { transform: scale(1); }
      100% { transform: scale(1.03, 0.97); }
    }

    .cat-body-shape {
      width: 48px;
      height: 22px;
      background: #04060a;
      border-radius: 16px 20px 8px 8px;
      position: absolute;
      bottom: 0;
      right: 0;
    }

    .cat-head-shape {
      width: 18px;
      height: 16px;
      background: #04060a;
      border-radius: 50%;
      position: absolute;
      bottom: 4px;
      left: 4px;
    }

    .cat-ear {
      width: 0;
      height: 0;
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-bottom: 6px solid #04060a;
      position: absolute;
      top: -4px;
    }
    .cat-ear.e1 { left: 4px; }
    .cat-ear.e2 { left: 11px; }

    /* ==========================================================================
       MODE 4: DEEP SPACE EXPLORER
       ========================================================================== */
    #mode-space {
      background: #010204;
    }

    .space-nebula {
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(circle at 70% 30%, rgba(99, 102, 241, 0.15) 0%, transparent 55%),
        radial-gradient(circle at 25% 75%, rgba(168, 85, 247, 0.12) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(14, 165, 233, 0.1) 0%, transparent 45%);
      filter: blur(40px);
      -webkit-filter: blur(40px);
    }

    #space-stars-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    /* Central Majestic Celestial Planet */
    .space-planet-wrapper {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 320px;
      height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .space-planet-sphere {
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: 
        radial-gradient(circle at 35% 35%, rgba(255,255,255,0.12) 0%, transparent 60%),
        linear-gradient(135deg, #1e3a8a 0%, #0f172a 50%, #020617 85%, #000000 100%);
      box-shadow: 
        inset -25px -25px 45px rgba(0, 0, 0, 0.95),
        inset 10px 10px 30px rgba(56, 189, 248, 0.4),
        0 0 60px rgba(56, 189, 248, 0.2);
      position: relative;
      overflow: hidden;
      z-index: 10;
    }

    .planet-atmosphere-rim {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow: 0 0 45px rgba(56, 189, 248, 0.35);
      pointer-events: none;
    }

    .planet-cloud-band {
      position: absolute;
      width: 200%;
      height: 24px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
      top: 42%;
      left: -50%;
      transform: rotate(-18deg);
      filter: blur(4px);
    }

    /* Planetary Ring */
    .space-planet-ring {
      position: absolute;
      width: 440px;
      height: 110px;
      border-radius: 50%;
      border: 12px solid rgba(147, 197, 253, 0.16);
      border-top-color: rgba(147, 197, 253, 0.32);
      box-shadow: 0 0 35px rgba(147, 197, 253, 0.2);
      transform: rotate(-24deg);
      pointer-events: none;
      z-index: 15;
    }

    .space-planet-ring::after {
      content: "";
      position: absolute;
      inset: -18px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, 0.08);
    }

    /* Shooting Star */
    .shooting-star-streak {
      position: absolute;
      height: 2px;
      background: linear-gradient(90deg, #ffffff, rgba(56, 189, 248, 0.8), transparent);
      border-radius: var(--radius-full);
      filter: drop-shadow(0 0 6px #38bdf8);
      opacity: 0;
      transform: rotate(-35deg);
      pointer-events: none;
      z-index: 5;
    }

    /* ==========================================================================
       MODE 5: MOUNTAIN ESCAPE
       ========================================================================== */
    #mode-mountains {
      background: #040711;
    }

    /* Midnight Palette (Default) */
    .mountains-scene.theme-midnight .m-sky {
      background: linear-gradient(180deg, #02050e 0%, #0b152d 55%, #18284b 100%);
    }
    .mountains-scene.theme-midnight .m-celestial {
      background: #f8fafc;
      box-shadow: 0 0 35px rgba(248, 250, 252, 0.8), 0 0 80px rgba(56, 189, 248, 0.4);
    }

    /* Sunset Palette */
    .mountains-scene.theme-sunset .m-sky {
      background: linear-gradient(180deg, #2e1065 0%, #7c2d12 40%, #ea580c 75%, #f59e0b 100%);
    }
    .mountains-scene.theme-sunset .m-celestial {
      background: #fef08a;
      box-shadow: 0 0 50px rgba(245, 158, 11, 0.9), 0 0 100px rgba(234, 88, 12, 0.5);
    }

    /* Snowy Winter Palette */
    .mountains-scene.theme-winter .m-sky {
      background: linear-gradient(180deg, #090e17 0%, #17253a 50%, #293d5a 100%);
    }
    .mountains-scene.theme-winter .m-celestial {
      background: #e2e8f0;
      box-shadow: 0 0 40px rgba(226, 232, 240, 0.8);
    }

    .m-sky {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 62%;
      overflow: hidden;
      transition: background 1.2s ease;
    }

    .m-celestial {
      position: absolute;
      top: 14%;
      right: 22%;
      width: 70px;
      height: 70px;
      border-radius: 50%;
      transition: all 1.2s ease;
    }

    .m-clouds {
      position: absolute;
      inset: 0;
      opacity: 0.25;
      background: radial-gradient(ellipse at 30% 60%, rgba(255,255,255,0.4) 0%, transparent 60%);
      animation: cloudDrift 60s linear infinite alternate;
    }

    @keyframes cloudDrift {
      0% { transform: translateX(-5%); }
      100% { transform: translateX(5%); }
    }

    .m-svg-mountains {
      position: absolute;
      bottom: 35%;
      left: 0;
      width: 100%;
      height: 48%;
      z-index: 10;
    }

    /* Alpine Lake Reflection Area */
    .m-lake {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 38%;
      background: linear-gradient(180deg, #060b18 0%, #03050a 100%);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
      z-index: 15;
    }

    .m-reflection-container {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 100%;
      transform: scaleY(-1);
      opacity: 0.38;
      filter: blur(2px);
    }

    .m-water-ripples {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.04) 0px,
        rgba(255, 255, 255, 0.04) 2px,
        transparent 2px,
        transparent 14px
      );
      animation: rippleShimmer 4s ease-in-out infinite alternate;
    }

    @keyframes rippleShimmer {
      0% { opacity: 0.2; transform: translateY(0); }
      100% { opacity: 0.5; transform: translateY(3px); }
    }

    /* ==========================================================================
       MODE 6: CYBERPUNK CITY
       ========================================================================== */
    #mode-cyberpunk {
      background: #020307;
    }

    .cyber-sky {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 70%;
      background: linear-gradient(180deg, #020307 0%, #08031a 50%, #15062b 100%);
    }

    .cyber-searchlights {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .cyber-beam {
      position: absolute;
      bottom: 25%;
      left: 45%;
      width: 140px;
      height: 900px;
      background: linear-gradient(180deg, transparent 0%, rgba(56, 189, 248, 0.12) 60%, rgba(168, 85, 247, 0.25) 100%);
      transform-origin: 50% 100%;
      filter: blur(12px);
      animation: searchlightSweep 12s ease-in-out infinite alternate;
    }

    @keyframes searchlightSweep {
      0% { transform: rotate(-35deg); }
      100% { transform: rotate(35deg); }
    }

    .cyber-skyline-svg {
      position: absolute;
      bottom: 20%;
      left: 0;
      width: 100%;
      height: 65%;
      z-index: 10;
    }

    /* Futuristic flying vehicles / spinners */
    .cyber-spinner {
      position: absolute;
      width: 22px;
      height: 5px;
      background: #00f0ff;
      border-radius: 2px;
      box-shadow: 0 0 12px #00f0ff, -20px 0 16px rgba(0, 240, 255, 0.6);
      z-index: 15;
      opacity: 0;
    }

    /* Neon Hologram Signage */
    .cyber-neon-sign {
      position: absolute;
      padding: 4px 10px;
      border: 1px solid var(--accent-rose);
      color: var(--accent-rose);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      border-radius: 4px;
      box-shadow: 0 0 14px rgba(244, 63, 94, 0.6), inset 0 0 8px rgba(244, 63, 94, 0.4);
      text-shadow: 0 0 8px var(--accent-rose);
      z-index: 20;
    }

    /* Wet Road & Street Reflections */
    .cyber-wet-ground {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 22%;
      background: linear-gradient(180deg, #090314 0%, #020105 100%);
      border-top: 1px solid rgba(168, 85, 247, 0.3);
      z-index: 25;
      overflow: hidden;
    }

    .cyber-neon-reflections {
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(ellipse at 30% 0%, rgba(0, 240, 255, 0.3) 0%, transparent 60%),
        radial-gradient(ellipse at 70% 0%, rgba(244, 63, 94, 0.35) 0%, transparent 60%);
      filter: blur(10px);
    }

    /* ==========================================================================
       MODE 7: FIREPLACE & WINTER CABIN
       ========================================================================== */
    #mode-fireplace {
      background: #070503;
    }

    .fireplace-ambient-warmth {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 75%, rgba(245, 158, 11, 0.25) 0%, rgba(180, 83, 9, 0.08) 50%, transparent 80%);
      animation: ambientGlowPulse 2.4s ease-in-out infinite alternate;
    }

    @keyframes ambientGlowPulse {
      0% { opacity: 0.75; transform: scale(1); }
      100% { opacity: 1; transform: scale(1.04); }
    }

    .fireplace-hearth-wrapper {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 440px;
      height: 380px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      z-index: 20;
    }

    .hearth-arch {
      width: 320px;
      height: 240px;
      background: #020101;
      border: 14px solid #1c1511;
      border-bottom: none;
      border-radius: 120px 120px 0 0;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.95);
    }

    .fire-logs {
      position: absolute;
      bottom: 12px;
      width: 180px;
      height: 36px;
      background: #190f07;
      border-radius: 18px;
      border: 2px solid #2b180d;
      z-index: 10;
    }

    .fire-embers-bed {
      position: absolute;
      bottom: 8px;
      width: 200px;
      height: 20px;
      background: radial-gradient(ellipse at center, #ea580c 0%, #7c2d12 60%, transparent 100%);
      box-shadow: 0 0 25px #ea580c;
      border-radius: 50%;
      z-index: 12;
      animation: emberPulse 1.8s ease-in-out infinite alternate;
    }

    @keyframes emberPulse {
      0% { opacity: 0.7; }
      100% { opacity: 1; }
    }

    /* Procedural Flame Layers */
    .fire-flames-container {
      position: absolute;
      bottom: 24px;
      width: 140px;
      height: 150px;
      z-index: 15;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .flame-tongue {
      position: absolute;
      bottom: 0;
      border-radius: 50% 50% 20% 20% / 60% 60% 40% 40%;
      transform-origin: 50% 100%;
    }

    .flame-t1 {
      width: 90px;
      height: 130px;
      background: radial-gradient(ellipse at 50% 85%, #fef08a 0%, #f97316 50%, #c2410c 80%, transparent 100%);
      animation: flameMotion1 1.2s ease-in-out infinite alternate;
      box-shadow: 0 0 45px rgba(249, 115, 22, 0.7);
    }

    .flame-t2 {
      width: 65px;
      height: 105px;
      background: radial-gradient(ellipse at 50% 85%, #ffffff 0%, #fef08a 40%, #ea580c 80%, transparent 100%);
      animation: flameMotion2 0.9s ease-in-out infinite alternate;
    }

    .flame-t3 {
      width: 45px;
      height: 75px;
      background: radial-gradient(ellipse at 50% 85%, #ffffff 0%, #fef08a 60%, #f97316 100%);
      animation: flameMotion3 0.7s ease-in-out infinite alternate;
    }

    @keyframes flameMotion1 {
      0% { transform: scale(0.95, 0.95) rotate(-2deg); }
      100% { transform: scale(1.05, 1.08) rotate(3deg); }
    }
    @keyframes flameMotion2 {
      0% { transform: scale(1.04, 0.96) rotate(3deg); }
      100% { transform: scale(0.96, 1.04) rotate(-3deg); }
    }
    @keyframes flameMotion3 {
      0% { transform: scale(0.9, 1.1) rotate(-1deg); }
      100% { transform: scale(1.1, 0.9) rotate(2deg); }
    }

    /* Cabin Window with gently falling snow */
    .cabin-window {
      position: absolute;
      top: 60px;
      right: 90px;
      width: 180px;
      height: 220px;
      background: #030814;
      border: 8px solid #140d08;
      box-shadow: inset 0 0 25px rgba(0, 0, 0, 0.9);
      border-radius: 4px;
      overflow: hidden;
      z-index: 5;
    }

    #snow-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    /* ==========================================================================
       MODE 8: MINIMAL AQUARIUM
       ========================================================================== */
    #mode-aquarium {
      background: radial-gradient(circle at 50% 0%, #062b47 0%, #031526 50%, #010811 100%);
    }

    .aquarium-caustics {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        75deg,
        rgba(56, 189, 248, 0.05) 0px,
        rgba(56, 189, 248, 0.12) 40px,
        transparent 60px,
        transparent 120px
      );
      filter: blur(18px);
      animation: causticsWave 9s ease-in-out infinite alternate;
      pointer-events: none;
    }

    @keyframes causticsWave {
      0% { transform: scale(1) translateY(0); opacity: 0.6; }
      100% { transform: scale(1.08) translateY(-15px); opacity: 0.95; }
    }

    /* Swimming Fish Silhouettes */
    .aquarium-entity {
      position: absolute;
      pointer-events: none;
      z-index: 10;
    }

    #aquarium-fish-1 {
      top: 32%;
      animation: fishSwim1 24s linear infinite;
    }
    #aquarium-fish-2 {
      top: 58%;
      animation: fishSwim2 28s linear infinite -10s;
    }
    #aquarium-manta {
      top: 18%;
      animation: mantaGlide 36s linear infinite -18s;
    }

    @keyframes fishSwim1 {
      0% { left: -120px; transform: scaleX(1) translateY(0); }
      50% { transform: scaleX(1) translateY(-25px); }
      100% { left: calc(100vw + 120px); transform: scaleX(1) translateY(15px); }
    }

    @keyframes fishSwim2 {
      0% { right: -120px; transform: scaleX(-1) scale(0.7) translateY(0); }
      50% { transform: scaleX(-1) scale(0.7) translateY(20px); }
      100% { right: calc(100vw + 120px); transform: scaleX(-1) scale(0.7) translateY(-20px); }
    }

    @keyframes mantaGlide {
      0% { left: -220px; transform: translateY(0); }
      50% { transform: translateY(-30px); }
      100% { left: calc(100vw + 220px); transform: translateY(20px); }
    }

    .fish-shape {
      fill: rgba(3, 15, 28, 0.95);
      filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.6));
      animation: fishFinWag 0.8s ease-in-out infinite alternate;
      transform-origin: 20% 50%;
    }

    @keyframes fishFinWag {
      0% { transform: scaleY(1) rotate(-1.5deg); }
      100% { transform: scaleY(0.96) rotate(1.5deg); }
    }

    /* Rising Bubbles */
    .aquarium-bubble {
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.7) 0%, rgba(56, 189, 248, 0.3) 60%, transparent 100%);
      border: 1px solid rgba(255, 255, 255, 0.3);
      pointer-events: none;
      z-index: 12;
      animation: bubbleRise 8s linear infinite;
    }
    .aquarium-bubble.b1 { width: 10px; height: 10px; left: 22%; animation-duration: 9s; animation-delay: 0s; }
    .aquarium-bubble.b2 { width: 14px; height: 14px; left: 45%; animation-duration: 12s; animation-delay: -3.5s; }
    .aquarium-bubble.b3 { width: 8px; height: 8px; left: 68%; animation-duration: 8s; animation-delay: -5s; }
    .aquarium-bubble.b4 { width: 12px; height: 12px; left: 82%; animation-duration: 11s; animation-delay: -1.8s; }

    @keyframes bubbleRise {
      0% { bottom: -20px; transform: translateX(0); opacity: 0; }
      15% { opacity: 0.65; }
      85% { opacity: 0.65; }
      100% { bottom: 105%; transform: translateX(25px); opacity: 0; }
    }

    /* Seabed Flora Silhouettes */
    .aquarium-seabed {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 120px;
      display: flex;
      align-items: flex-end;
      justify-content: space-around;
      pointer-events: none;
      z-index: 8;
    }

    .kelp-stalk {
      width: 14px;
      height: 110px;
      background: linear-gradient(180deg, #02121f, #01060c);
      border-radius: 50% 50% 0 0;
      transform-origin: 50% 100%;
      animation: kelpSway 4.5s ease-in-out infinite alternate;
    }

    @keyframes kelpSway {
      0% { transform: rotate(-6deg); }
      100% { transform: rotate(8deg); }
    }

    /* ==========================================================================
       MODE 9: DIGITAL ZEN
       ========================================================================== */
    #mode-zen {
      background: #05070a;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .zen-gyro-stage {
      width: 400px;
      height: 400px;
      perspective: 1000px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .zen-ring {
      position: absolute;
      border-radius: 50%;
      border: 1.5px solid transparent;
      transform-style: preserve-3d;
    }

    .zen-ring-1 {
      width: 320px;
      height: 320px;
      border-color: rgba(56, 189, 248, 0.35);
      box-shadow: 0 0 25px rgba(56, 189, 248, 0.15);
      animation: gyroRotate1 22s linear infinite;
    }

    .zen-ring-2 {
      width: 250px;
      height: 250px;
      border-color: rgba(168, 85, 247, 0.35);
      box-shadow: 0 0 25px rgba(168, 85, 247, 0.15);
      animation: gyroRotate2 16s linear infinite reverse;
    }

    .zen-ring-3 {
      width: 180px;
      height: 180px;
      border-color: rgba(16, 185, 129, 0.35);
      box-shadow: 0 0 25px rgba(16, 185, 129, 0.15);
      animation: gyroRotate3 12s linear infinite;
    }

    @keyframes gyroRotate1 {
      0% { transform: rotateX(65deg) rotateY(20deg) rotateZ(0deg); }
      100% { transform: rotateX(65deg) rotateY(20deg) rotateZ(360deg); }
    }

    @keyframes gyroRotate2 {
      0% { transform: rotateX(25deg) rotateY(65deg) rotateZ(0deg); }
      100% { transform: rotateX(25deg) rotateY(65deg) rotateZ(360deg); }
    }

    @keyframes gyroRotate3 {
      0% { transform: rotateX(45deg) rotateY(45deg) rotateZ(0deg); }
      100% { transform: rotateX(45deg) rotateY(45deg) rotateZ(360deg); }
    }

    /* Core Pulsing Orb */
    .zen-core-orb {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #ffffff 0%, #38bdf8 50%, #6366f1 100%);
      box-shadow: 0 0 50px rgba(56, 189, 248, 0.6), 0 0 90px rgba(99, 102, 241, 0.3);
      animation: zenBreathe 6s ease-in-out infinite alternate;
      z-index: 10;
    }

    @keyframes zenBreathe {
      0% { transform: scale(0.85); box-shadow: 0 0 35px rgba(56, 189, 248, 0.4); }
      100% { transform: scale(1.15); box-shadow: 0 0 75px rgba(56, 189, 248, 0.8), 0 0 110px rgba(168, 85, 247, 0.4); }
    }

    /* Breath Pacer Guidance */
    .zen-breath-guide {
      position: absolute;
      bottom: 80px;
      font-size: 0.82rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--text-muted);
      font-family: var(--font-mono);
      animation: breathGuideText 6s ease-in-out infinite alternate;
    }

    @keyframes breathGuideText {
      0% { opacity: 0.4; }
      100% { opacity: 0.9; color: var(--accent-cyan); }
    }

    /* ==========================================================================
       9. RESPONSIVE BREAKPOINTS
       ========================================================================== */
    @media (max-width: 900px) {
      .dashboard-header { padding: 18px 24px; }
      .dashboard-hero { padding: 28px 24px 16px; }
      .modes-grid { padding: 0 24px; grid-template-columns: 1fr; }
      .hero-top-row { flex-direction: column; align-items: flex-start; }
      .hero-quick-stats { width: 100%; justify-content: flex-start; }
      #screensaver-hud { width: 92%; padding: 8px 16px; gap: 10px; justify-content: space-between; }
      .hud-brightness-bar { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- ========================================================================
       DASHBOARD CONFIGURATION INTERFACE
       ======================================================================== -->
  <main id="dashboard-view">
    
    <!-- Header -->
    <header class="dashboard-header">
      <div class="brand-group">
        <div class="brand-logo-icon">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
        <div class="brand-text">
          <h1>AWAKEN <span class="badge-pro">PRO 2.4</span></h1>
          <p>Ultra-Low Power Ambient Displays & OLED Care</p>
        </div>
      </div>

      <div class="header-actions">
        <!-- Screen Wake Lock Toggle Pill -->
        <button id="wakelock-pill" class="status-pill clickable" title="Toggle Screen Wake Lock API">
          <span id="wakelock-dot" class="status-dot"></span>
          <span id="wakelock-text">Wake Lock: Off</span>
        </button>

        <!-- Fullscreen Button -->
        <button id="fullscreen-btn" class="icon-btn" title="Toggle Fullscreen (F)">
          <svg viewBox="0 0 24 24">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
          </svg>
        </button>

        <!-- Global Settings Button -->
        <button id="settings-btn" class="icon-btn" title="Configure Settings (S)">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </button>

        <!-- Primary Start Screensaver Button -->
        <button id="start-screensaver-btn" class="primary-start-btn">
          <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span>Start Screensaver</span>
        </button>
      </div>
    </header>

    <!-- Hero Area -->
    <section class="dashboard-hero">
      <div class="hero-top-row">
        <div class="hero-title-area">
          <h2>Select Ambient Environment</h2>
          <p>Choose between true zero-resource OLED sleep screens or immersive, high-fidelity ambient environments.</p>
        </div>

        <div class="hero-quick-stats">
          <div class="stat-badge">
            <div class="stat-label">Active Mode</div>
            <div id="stat-selected-mode" class="stat-val">Minimal</div>
          </div>
          <div class="stat-badge">
            <div class="stat-label">OLED Burn-In Care</div>
            <div id="stat-burnin-val" class="stat-val" style="color: var(--accent-emerald);">Active</div>
          </div>
          <div class="stat-badge">
            <div class="stat-label">Screen Lock</div>
            <div id="stat-lock-val" class="stat-val" style="color: var(--accent-cyan);">Ready</div>
          </div>
        </div>
      </div>

      <!-- Filter Tabs -->
      <div class="mode-filter-bar">
        <div class="filter-tabs">
          <button class="filter-tab active" data-filter="all">All Modes (9)</button>
          <button class="filter-tab" data-filter="ultra-low">Ultra Low Resource</button>
          <button class="filter-tab" data-filter="cinematic">Cinematic</button>
          <button class="filter-tab" data-filter="relaxing">Relaxing</button>
          <button class="filter-tab" data-filter="abstract">Abstract</button>
        </div>
        <div class="filter-info-hint">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          Click any card to select. Press <kbd>Space</kbd> or <kbd>Enter</kbd> to launch.
        </div>
      </div>
    </section>

    <!-- 9 Modes Grid -->
    <section class="modes-grid">

      <!-- MODE 1 -->
      <article class="mode-card selected" data-mode-id="mode-minimal" data-category="ultra-low">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background:#000; display:flex; align-items:center; justify-content:center;">
            <div style="font-size: 1.4rem; font-weight: 300; color: rgba(255,255,255,0.3); font-family: var(--font-stack);">21:45</div>
          </div>
          <span class="card-badge-tier tier-ultra-low">Ultra Low Resource</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Absolute Minimal</h3>
            <span class="card-mode-num">MODE 01</span>
          </div>
          <p class="card-desc">Pitch-black OLED standby. Zero continuous loops, no canvas rendering, and clock updates strictly once per minute. Ideal for overnight screen keeping.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill low"></div></div>
              <span style="color:var(--accent-emerald);">~0.01%</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

      <!-- MODE 2 -->
      <article class="mode-card" data-mode-id="mode-drive" data-category="cinematic">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background: radial-gradient(ellipse at 50% 100%, #1e293b 0%, #030611 100%); display:flex; align-items:center; justify-content:center; overflow:hidden;">
            <div style="width: 50px; height: 18px; background: #090e1a; border-radius: 4px; border-top:1px solid rgba(255,255,255,0.2); display:flex; justify-content:space-between; padding:0 4px; align-items:center;">
              <span style="width:6px; height:3px; background:#e11d48; border-radius:1px; box-shadow:0 0 6px red;"></span>
              <span style="width:6px; height:3px; background:#e11d48; border-radius:1px; box-shadow:0 0 6px red;"></span>
            </div>
          </div>
          <span class="card-badge-tier tier-cinematic">Cinematic</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Autonomous Night Drive</h3>
            <span class="card-mode-num">MODE 02</span>
          </div>
          <p class="card-desc">Smooth highway stretching into the midnight horizon. Glowing taillights, forward headlight beams, and passing road streetlights in 3D perspective.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill cinematic"></div></div>
              <span style="color:var(--accent-amber);">CSS 3D</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

      <!-- MODE 3 -->
      <article class="mode-card" data-mode-id="mode-rain" data-category="relaxing">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background: radial-gradient(circle at 30% 40%, rgba(245,158,11,0.3), transparent 60%), radial-gradient(circle at 70% 60%, rgba(56,189,248,0.3), #050811); filter: blur(4px);"></div>
          <span class="card-badge-tier tier-relaxing">Relaxing</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Cozy Rainy Window</h3>
            <span class="card-mode-num">MODE 03</span>
          </div>
          <p class="card-desc">Rain droplets sliding down glass over blurry city bokeh. Includes a flickering candle, steaming mug, curled sleeping cat, and subtle distant lightning flashes.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill med"></div></div>
              <span style="color:var(--accent-cyan);">Lightweight</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

      <!-- MODE 4 -->
      <article class="mode-card" data-mode-id="mode-space" data-category="cinematic">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background: radial-gradient(circle at 50% 50%, #1e1b4b 0%, #020617 80%); display:flex; align-items:center; justify-content:center;">
            <div style="width: 50px; height: 50px; border-radius:50%; background: linear-gradient(135deg, #1d4ed8, #030712); box-shadow: 0 0 20px rgba(56,189,248,0.5);"></div>
          </div>
          <span class="card-badge-tier tier-cinematic">Cosmic</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Deep Space Explorer</h3>
            <span class="card-mode-num">MODE 04</span>
          </div>
          <p class="card-desc">Peaceful cosmic vista featuring a slowly orbiting celestial gas giant, atmospheric ring system, deep nebulas, and occasional graceful shooting stars.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill med"></div></div>
              <span style="color:var(--accent-cyan);">Balanced</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

      <!-- MODE 5 -->
      <article class="mode-card" data-mode-id="mode-mountains" data-category="relaxing">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background: linear-gradient(180deg, #0b1329 0%, #1e293b 60%, #030712 100%); display:flex; align-items:flex-end; justify-content:center;">
            <div style="width: 80px; height: 35px; background: #070d1a; clip-path: polygon(50% 0%, 0% 100%, 100% 100%);"></div>
          </div>
          <span class="card-badge-tier tier-relaxing">Nature</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Mountain Escape</h3>
            <span class="card-mode-num">MODE 05</span>
          </div>
          <p class="card-desc">Layered mountain silhouettes with drifting clouds and a calm alpine lake reflection. Supports Midnight, Golden Sunset, and Snowy Winter color palettes.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill low"></div></div>
              <span style="color:var(--accent-emerald);">CSS Layers</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

      <!-- MODE 6 -->
      <article class="mode-card" data-mode-id="mode-cyberpunk" data-category="cinematic">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background: linear-gradient(180deg, #08031a 0%, #17072e 60%, #040108 100%); display:flex; align-items:center; justify-content:center;">
            <span style="padding: 2px 8px; border:1px solid #f43f5e; color:#f43f5e; font-size:0.65rem; font-weight:700; box-shadow:0 0 10px #f43f5e;">NEO 2088</span>
          </div>
          <span class="card-badge-tier tier-cinematic">Cyberpunk</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Cyberpunk City</h3>
            <span class="card-mode-num">MODE 06</span>
          </div>
          <p class="card-desc">Futuristic skyline bathed in neon violet, cyan, and magenta. Sweeping searchlights, flying hover spinners, and reflective wet street surfaces.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill cinematic"></div></div>
              <span style="color:var(--accent-amber);">Dynamic</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

      <!-- MODE 7 -->
      <article class="mode-card" data-mode-id="mode-fireplace" data-category="relaxing">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background: radial-gradient(circle at 50% 80%, #ea580c 0%, #451a03 60%, #0a0604 100%); display:flex; align-items:center; justify-content:center;">
            <div style="width: 28px; height: 35px; background: radial-gradient(ellipse at center, #fef08a, #ea580c); border-radius:50% 50% 20% 20%; box-shadow:0 0 15px #f97316;"></div>
          </div>
          <span class="card-badge-tier tier-relaxing">Cozy</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Fireplace & Cabin</h3>
            <span class="card-mode-num">MODE 07</span>
          </div>
          <p class="card-desc">Timber cabin hearth with procedural animated flame tongues, pulsing embers, ambient warm light cast, and a side window overlooking gentle falling snow.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill med"></div></div>
              <span style="color:var(--accent-cyan);">Relaxing</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

      <!-- MODE 8 -->
      <article class="mode-card" data-mode-id="mode-aquarium" data-category="relaxing">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background: radial-gradient(circle at 50% 20%, #0c4a6e 0%, #082f49 50%, #020617 100%); display:flex; align-items:center; justify-content:center;">
            <svg width="40" height="20" viewBox="0 0 50 25" fill="rgba(2, 6, 23, 0.9)"><path d="M5 12 Q20 2 35 12 Q20 22 5 12 Z M35 12 L48 4 L48 20 Z"/></svg>
          </div>
          <span class="card-badge-tier tier-relaxing">Underwater</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Minimal Aquarium</h3>
            <span class="card-mode-num">MODE 08</span>
          </div>
          <p class="card-desc">Deep oceanic abyss with atmospheric light caustics, gracefully gliding fish silhouettes, a soaring manta ray, rising effervescent bubbles, and swaying kelp.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill low"></div></div>
              <span style="color:var(--accent-emerald);">Gentle</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

      <!-- MODE 9 -->
      <article class="mode-card" data-mode-id="mode-zen" data-category="abstract">
        <div class="card-thumbnail">
          <div class="card-thumbnail-preview" style="background: #030712; display:flex; align-items:center; justify-content:center;">
            <div style="width: 44px; height: 44px; border:1px solid #38bdf8; border-radius:50%; box-shadow:0 0 12px rgba(56,189,248,0.4);"></div>
          </div>
          <span class="card-badge-tier tier-abstract">Abstract</span>
          <div class="card-selection-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title">Digital Zen</h3>
            <span class="card-mode-num">MODE 09</span>
          </div>
          <p class="card-desc">Meditative 3D geometric gyroscope rings rotating smoothly around a breathing chromatic orb, paired with an integrated breath pacer and minimal typography.</p>
          <div class="card-footer">
            <div class="card-resource-meter">
              <span>CPU/GPU:</span>
              <div class="meter-bar"><div class="meter-fill low"></div></div>
              <span style="color:var(--accent-emerald);">Hypnotic</span>
            </div>
            <div class="card-launch-action">Launch &rarr;</div>
          </div>
        </div>
      </article>

    </section>

    <!-- Keyboard Shortcuts Legend -->
    <section class="shortcuts-section">
      <div class="shortcuts-container">
        <div class="shortcuts-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="6" y1="8" x2="6" y2="8"/><line x1="10" y1="8" x2="10" y2="8"/><line x1="14" y1="8" x2="14" y2="8"/><line x1="18" y1="8" x2="18" y2="8"/><line x1="6" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="18" y2="12"/><line x1="8" y1="16" x2="16" y2="16"/></svg>
          Quick Controls
        </div>
        <div class="shortcut-chips">
          <div class="shortcut-chip"><kbd>Esc</kbd> <span>Exit to Menu</span></div>
          <div class="shortcut-chip"><kbd>Space</kbd> <span>Pause / Resume</span></div>
          <div class="shortcut-chip"><kbd>&larr;</kbd><kbd>&rarr;</kbd> <span>Switch Mode</span></div>
          <div class="shortcut-chip"><kbd>&uarr;</kbd><kbd>&darr;</kbd> <span>Adjust Brightness</span></div>
          <div class="shortcut-chip"><kbd>F</kbd> <span>Fullscreen</span></div>
          <div class="shortcut-chip"><kbd>C</kbd> <span>Toggle Clock</span></div>
          <div class="shortcut-chip"><kbd>M</kbd> <span>Mute / Sound</span></div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="dashboard-footer">
      <div class="footer-left">
        <span>&copy; 2026 AWAKEN Technologies</span>
        <span>&bull;</span>
        <span>Single-File Pure Vanilla Architecture</span>
        <span>&bull;</span>
        <span>100% Offline Capable</span>
      </div>
      <div>
        <span>OLED Subpixel Burn-In Shift Active (Anti-Static Retention)</span>
      </div>
    </footer>
  </main>

  <!-- ========================================================================
       SETTINGS MODAL
       ======================================================================== -->
  <div id="settings-modal" class="modal-backdrop">
    <div class="modal-window">
      <div class="modal-header">
        <h3>Screensaver Preferences</h3>
        <button id="close-settings-btn" class="icon-btn">
          <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="modal-content">
        
        <!-- Group: Display & Clock -->
        <div class="settings-group">
          <div class="settings-group-title">Clock & HUD Overlay</div>
          
          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Show Digital Clock</span>
              <span class="setting-hint">Display time and date overlay across scenes</span>
            </div>
            <label class="switch">
              <input type="checkbox" id="setting-clock-enable" checked>
              <span class="switch-slider"></span>
            </label>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">24-Hour Time Format</span>
              <span class="setting-hint">Toggle between 24-hour (14:30) and 12-hour (2:30 PM)</span>
            </div>
            <label class="switch">
              <input type="checkbox" id="setting-clock-24h" checked>
              <span class="switch-slider"></span>
            </label>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Display Seconds</span>
              <span class="setting-hint">Shows live ticking seconds (Auto-disabled in Mode 1 for energy savings)</span>
            </div>
            <label class="switch">
              <input type="checkbox" id="setting-clock-seconds">
              <span class="switch-slider"></span>
            </label>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Show Date</span>
              <span class="setting-hint">Displays day and date beneath clock</span>
            </div>
            <label class="switch">
              <input type="checkbox" id="setting-clock-date" checked>
              <span class="switch-slider"></span>
            </label>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Clock Opacity</span>
              <span class="setting-hint">Dim the clock for night or OLED displays</span>
            </div>
            <div class="range-control">
              <input type="range" id="setting-clock-opacity" class="range-slider" min="10" max="100" value="45">
              <span id="setting-clock-opacity-val" class="range-val">45%</span>
            </div>
          </div>
        </div>

        <!-- Group: OLED & Power -->
        <div class="settings-group">
          <div class="settings-group-title">OLED Protection & Energy</div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Screen Wake Lock API</span>
              <span class="setting-hint">Prevent screen sleep / display timeout while screensaver runs</span>
            </div>
            <label class="switch">
              <input type="checkbox" id="setting-wakelock-enable" checked>
              <span class="switch-slider"></span>
            </label>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">OLED Burn-In Pixel Shifter</span>
              <span class="setting-hint">Gradually drifts persistent text and clock positions over time</span>
            </div>
            <label class="switch">
              <input type="checkbox" id="setting-burnin-enable" checked>
              <span class="switch-slider"></span>
            </label>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Pixel Shift Interval</span>
              <span class="setting-hint">Frequency of micro-repositioning</span>
            </div>
            <select id="setting-burnin-interval" class="custom-select">
              <option value="1">Every 1 minute</option>
              <option value="2" selected>Every 2 minutes</option>
              <option value="5">Every 5 minutes</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Display Dimmer Level</span>
              <span class="setting-hint">Overall visual intensity reduction</span>
            </div>
            <div class="range-control">
              <input type="range" id="setting-brightness" class="range-slider" min="15" max="100" value="100">
              <span id="setting-brightness-val" class="range-val">100%</span>
            </div>
          </div>
        </div>

        <!-- Group: Environment & Behavior -->
        <div class="settings-group">
          <div class="settings-group-title">Environment & Behavior</div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Mountain Theme Palette (Mode 5)</span>
              <span class="setting-hint">Aesthetic color scheme for mountain landscape</span>
            </div>
            <select id="setting-mountain-palette" class="custom-select">
              <option value="midnight" selected>Midnight Mountains</option>
              <option value="sunset">Golden Sunset</option>
              <option value="winter">Snowy Winter Night</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Auto Mode Cycling</span>
              <span class="setting-hint">Automatically cycle between screensaver scenes</span>
            </div>
            <select id="setting-autocycle" class="custom-select">
              <option value="0" selected>Disabled (Stay on selected)</option>
              <option value="5">Every 5 minutes</option>
              <option value="15">Every 15 minutes</option>
              <option value="30">Every 30 minutes</option>
            </select>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Auto Fullscreen on Launch</span>
              <span class="setting-hint">Request native fullscreen mode when screensaver starts</span>
            </div>
            <label class="switch">
              <input type="checkbox" id="setting-auto-fullscreen">
              <span class="switch-slider"></span>
            </label>
          </div>

          <div class="setting-row">
            <div class="setting-info">
              <span class="setting-label">Ambient Sound Synthesis (Web Audio)</span>
              <span class="setting-hint">Procedural rain, crackling fire & cosmic drone (Zero audio files)</span>
            </div>
            <label class="switch">
              <input type="checkbox" id="setting-sound-enable">
              <span class="switch-slider"></span>
            </label>
          </div>
        </div>

      </div>

      <div class="modal-footer">
        <button id="reset-settings-btn" class="btn-secondary">Reset to Defaults</button>
        <button id="save-settings-btn" class="primary-start-btn" style="padding: 7px 18px;">Apply Changes</button>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       ACTIVE SCREENSAWER VIEWPORT (FULLSCREEN ENGINE)
       ======================================================================== -->
  <div id="screensaver-viewport">

    <!-- Dimmer Overlay for Intensity Control -->
    <div id="screensaver-dimmer"></div>

    <!-- Pause Indicator Badge -->
    <div id="screensaver-pause-badge">ANIMATION PAUSED &bull; [SPACE] TO RESUME</div>

    <!-- HUD Overlay Clock (Burn-In Shiftable) -->
    <div id="screensaver-clock-container">
      <div id="hud-clock-time" class="hud-time">
        <span id="hud-time-main">00:00</span><span id="hud-time-sec" class="hud-seconds">:00</span>
      </div>
      <div id="hud-clock-date" class="hud-date">Friday, November 6</div>
    </div>

    <!-- ================= SCENES ================= -->

    <!-- SCENE 1: ABSOLUTE MINIMAL -->
    <div id="mode-minimal" class="screensaver-scene">
      <div id="mode-minimal-display">
        <div id="minimal-clock-time" class="minimal-time">00:00</div>
        <div id="minimal-clock-date" class="minimal-date">Fri, Nov 6</div>
      </div>
    </div>

    <!-- SCENE 2: AUTONOMOUS NIGHT DRIVE -->
    <div id="mode-drive" class="screensaver-scene">
      <div class="drive-sky">
        <div class="drive-stars"></div>
        <div class="drive-city-silhouette" id="drive-city-container"></div>
        <div class="drive-horizon-glow"></div>
      </div>

      <div class="drive-streetlights-left">
        <div class="drive-light-pole left"></div>
      </div>
      <div class="drive-streetlights-right">
        <div class="drive-light-pole right"></div>
      </div>

      <div class="drive-road-container">
        <div class="drive-road-edge-left"></div>
        <div class="drive-road-edge-right"></div>
        <div class="drive-road-lines"></div>
        <div class="drive-headlight-cone"></div>
      </div>

      <div class="drive-car-silhouette">
        <div class="car-cabin">
          <div class="car-rear-windshield"></div>
        </div>
        <div class="car-bodywork">
          <div class="car-taillight"></div>
          <div class="car-taillight"></div>
          <div class="car-exhaust-glow"></div>
        </div>
      </div>
    </div>

    <!-- SCENE 3: COZY RAINY WINDOW -->
    <div id="mode-rain" class="screensaver-scene">
      <div class="rain-city-backdrop"></div>
      <div id="rain-lightning" class="rain-lightning-overlay"></div>
      <canvas id="rain-canvas"></canvas>
      <div class="rain-window-frame"></div>
      <div class="rain-window-sill">
        <!-- Candle -->
        <div class="sill-candle-group">
          <div class="candle-glass">
            <div class="candle-flame"></div>
            <div class="candle-wax"></div>
          </div>
        </div>
        <!-- Cat -->
        <div class="sill-cat-silhouette">
          <div class="cat-head-shape">
            <div class="cat-ear e1"></div>
            <div class="cat-ear e2"></div>
          </div>
          <div class="cat-body-shape"></div>
        </div>
        <!-- Coffee Mug -->
        <div class="sill-mug-group">
          <div class="mug-steam"></div>
          <div class="mug-cup">
            <div class="mug-handle"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- SCENE 4: DEEP SPACE EXPLORER -->
    <div id="mode-space" class="screensaver-scene">
      <div class="space-nebula"></div>
      <canvas id="space-stars-canvas"></canvas>
      <div class="space-planet-wrapper">
        <div class="space-planet-sphere">
          <div class="planet-atmosphere-rim"></div>
          <div class="planet-cloud-band"></div>
        </div>
        <div class="space-planet-ring"></div>
      </div>
      <div id="space-shooting-star" class="shooting-star-streak"></div>
    </div>

    <!-- SCENE 5: MOUNTAIN ESCAPE -->
    <div id="mode-mountains" class="screensaver-scene">
      <div class="mountains-scene theme-midnight" id="mountains-wrapper" style="width:100%; height:100%; position:relative;">
        <div class="m-sky">
          <div class="m-celestial"></div>
          <div class="m-clouds"></div>
        </div>
        <svg class="m-svg-mountains" viewBox="0 0 1440 400" preserveAspectRatio="none">
          <!-- Distant Range -->
          <polygon points="0,400 0,180 180,90 340,210 520,70 720,220 940,80 1120,200 1300,60 1440,160 1440,400" fill="#0c172d" opacity="0.6"/>
          <!-- Midground Jagged Ridge -->
          <polygon points="0,400 0,240 140,150 290,260 480,130 680,270 880,140 1060,260 1260,120 1440,230 1440,400" fill="#080f1e" opacity="0.85"/>
          <!-- Foreground Peaks & Pines -->
          <polygon points="0,400 0,310 100,240 220,330 380,220 540,320 720,210 900,310 1080,200 1240,320 1380,230 1440,280 1440,400" fill="#040810"/>
        </svg>
        <div class="m-lake">
          <div class="m-reflection-container">
            <svg class="m-svg-mountains" viewBox="0 0 1440 400" preserveAspectRatio="none">
              <polygon points="0,400 0,240 140,150 290,260 480,130 680,270 880,140 1060,260 1260,120 1440,230 1440,400" fill="#0c172d" opacity="0.7"/>
            </svg>
          </div>
          <div class="m-water-ripples"></div>
        </div>
      </div>
    </div>

    <!-- SCENE 6: CYBERPUNK CITY -->
    <div id="mode-cyberpunk" class="screensaver-scene">
      <div class="cyber-sky">
        <div class="cyber-searchlights">
          <div class="cyber-beam" style="left:28%;"></div>
          <div class="cyber-beam" style="left:68%; animation-delay:-5s;"></div>
        </div>
      </div>
      <div id="cyber-spinner-car" class="cyber-spinner"></div>
      <div class="cyber-neon-sign" style="top:32%; left:12%;">サイバー 2088</div>
      <div class="cyber-neon-sign" style="top:26%; right:16%; border-color:#00f0ff; color:#00f0ff; box-shadow:0 0 14px rgba(0,240,255,0.6); text-shadow:0 0 8px #00f0ff;">NEO TOKYO</div>
      <svg class="cyber-skyline-svg" viewBox="0 0 1400 600" preserveAspectRatio="none">
        <!-- Far layer -->
        <rect x="50" y="240" width="110" height="360" fill="#0a0518"/>
        <rect x="220" y="160" width="140" height="440" fill="#0d0720"/>
        <rect x="420" y="280" width="90" height="320" fill="#090416"/>
        <rect x="580" y="120" width="160" height="480" fill="#11092a"/>
        <rect x="800" y="220" width="120" height="380" fill="#0c061e"/>
        <rect x="980" y="180" width="150" height="420" fill="#0f0826"/>
        <rect x="1200" y="250" width="130" height="350" fill="#080315"/>
        <!-- Window illumination dots -->
        <circle cx="250" cy="200" r="2.5" fill="#00f0ff" opacity="0.8"/>
        <circle cx="270" cy="200" r="2.5" fill="#f43f5e" opacity="0.8"/>
        <circle cx="250" cy="240" r="2.5" fill="#fef08a" opacity="0.7"/>
        <circle cx="620" cy="180" r="2.5" fill="#00f0ff" opacity="0.9"/>
        <circle cx="650" cy="220" r="2.5" fill="#a855f7" opacity="0.8"/>
        <circle cx="1020" cy="240" r="2.5" fill="#f43f5e" opacity="0.85"/>
        <circle cx="1060" cy="280" r="2.5" fill="#00f0ff" opacity="0.9"/>
      </svg>
      <div class="cyber-wet-ground">
        <div class="cyber-neon-reflections"></div>
      </div>
    </div>

    <!-- SCENE 7: FIREPLACE & WINTER CABIN -->
    <div id="mode-fireplace" class="screensaver-scene">
      <div class="fireplace-ambient-warmth"></div>
      <!-- Cabin Window with Falling Snow -->
      <div class="cabin-window">
        <canvas id="snow-canvas"></canvas>
      </div>
      <!-- Fireplace Hearth -->
      <div class="fireplace-hearth-wrapper">
        <div class="hearth-arch">
          <div class="fire-embers-bed"></div>
          <div class="fire-flames-container">
            <div class="flame-tongue flame-t1"></div>
            <div class="flame-tongue flame-t2"></div>
            <div class="flame-tongue flame-t3"></div>
          </div>
          <div class="fire-logs"></div>
        </div>
      </div>
    </div>

    <!-- SCENE 8: MINIMAL AQUARIUM -->
    <div id="mode-aquarium" class="screensaver-scene">
      <div class="aquarium-caustics"></div>
      <!-- Rising Effervescent Bubbles -->
      <div class="aquarium-bubble b1"></div>
      <div class="aquarium-bubble b2"></div>
      <div class="aquarium-bubble b3"></div>
      <div class="aquarium-bubble b4"></div>
      <!-- Animated Fish Silhouettes -->
      <div id="aquarium-fish-1" class="aquarium-entity">
        <svg class="fish-shape" width="75" height="34" viewBox="0 0 100 45">
          <path d="M10 22 C30 5, 65 8, 85 22 C65 36, 30 39, 10 22 Z M85 22 L100 8 L95 22 L100 36 Z"/>
        </svg>
      </div>
      <div id="aquarium-fish-2" class="aquarium-entity">
        <svg class="fish-shape" width="75" height="34" viewBox="0 0 100 45">
          <path d="M10 22 C30 5, 65 8, 85 22 C65 36, 30 39, 10 22 Z M85 22 L100 8 L95 22 L100 36 Z"/>
        </svg>
      </div>
      <!-- Manta Ray Gliding -->
      <div id="aquarium-manta" class="aquarium-entity">
        <svg width="140" height="70" viewBox="0 0 140 70" fill="rgba(1, 8, 18, 0.9)">
          <path d="M10 35 Q40 5 70 30 Q100 5 130 35 Q100 55 70 45 Q40 55 10 35 Z M70 45 L70 70"/>
        </svg>
      </div>
      <!-- Kelp Stalks -->
      <div class="aquarium-seabed">
        <div class="kelp-stalk" style="height:140px; animation-delay:-1s;"></div>
        <div class="kelp-stalk" style="height:90px; animation-delay:-2.5s;"></div>
        <div class="kelp-stalk" style="height:160px; animation-delay:-0.5s;"></div>
        <div class="kelp-stalk" style="height:110px; animation-delay:-3s;"></div>
      </div>
    </div>

    <!-- SCENE 9: DIGITAL ZEN -->
    <div id="mode-zen" class="screensaver-scene">
      <div class="zen-gyro-stage">
        <div class="zen-ring zen-ring-1"></div>
        <div class="zen-ring zen-ring-2"></div>
        <div class="zen-ring zen-ring-3"></div>
        <div class="zen-core-orb"></div>
      </div>
      <div class="zen-breath-guide" id="zen-breath-text">INHALE &bull; EXHALE</div>
    </div>

    <!-- ================= FLOATING HUD DOCK ================= -->
    <div id="screensaver-hud">
      <div class="hud-mode-pill">
        <button id="hud-prev-mode" class="hud-nav-btn" title="Previous Mode (&larr;)">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <span id="hud-current-mode-name">Absolute Minimal</span>
        <button id="hud-next-mode" class="hud-nav-btn" title="Next Mode (&rarr;)">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

      <div class="hud-controls-group">
        <!-- Mountain Palette Cycler (Visible in Mode 5) -->
        <button id="hud-mountain-btn" class="hud-btn" style="display:none;" title="Cycle Mountain Palette">
          <svg viewBox="0 0 24 24"><polygon points="12 2 2 22 22 22"/></svg>
          <span id="hud-mountain-text">Midnight</span>
        </button>

        <!-- Sound Synthesis Toggle -->
        <button id="hud-sound-btn" class="hud-btn" title="Toggle Synthesized Audio (M)">
          <svg viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          <span id="hud-sound-text">Muted</span>
        </button>

        <!-- Wake Lock Indicator -->
        <button id="hud-wakelock-btn" class="hud-btn active" title="Wake Lock Protection">
          <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span id="hud-wakelock-text">Awake</span>
        </button>

        <!-- In-Screensaver Brightness Slider -->
        <div class="hud-brightness-bar" title="Brightness / Dimmer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <input type="range" id="hud-dimmer-slider" class="hud-brightness-slider" min="15" max="100" value="100">
        </div>

        <!-- Exit Screensaver Button -->
        <button id="hud-exit-btn" class="hud-btn hud-exit-btn" title="Exit Screensaver (Esc)">
          <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <span>Exit</span>
        </button>
      </div>
    </div>

  </div>

  <!-- ========================================================================
       APPLICATION LOGIC & ENGINES (PURE VANILLA JAVASCRIPT)
       ======================================================================== -->
  <script>
    /**
     * AWAKEN — Premium Screensaver & OLED Care Engine
     * Architecture: Single-file zero-dependency vanilla JS system
     */
    (function () {
      'use strict';

      // =======================================================================
      // 1. APPLICATION STATE & STORAGE
      // =======================================================================
      const STORAGE_KEY = 'awaken_screensaver_v2_settings';

      const MODES = [
        { id: 'mode-minimal', name: 'Absolute Minimal', tier: 'Ultra Low', category: 'ultra-low' },
        { id: 'mode-drive', name: 'Autonomous Night Drive', tier: 'Cinematic', category: 'cinematic' },
        { id: 'mode-rain', name: 'Cozy Rainy Window', tier: 'Relaxing', category: 'relaxing' },
        { id: 'mode-space', name: 'Deep Space Explorer', tier: 'Cosmic', category: 'cinematic' },
        { id: 'mode-mountains', name: 'Mountain Escape', tier: 'Nature', category: 'relaxing' },
        { id: 'mode-cyberpunk', name: 'Cyberpunk City', tier: 'Futuristic', category: 'cinematic' },
        { id: 'mode-fireplace', name: 'Fireplace & Cabin', tier: 'Cozy', category: 'relaxing' },
        { id: 'mode-aquarium', name: 'Minimal Aquarium', tier: 'Underwater', category: 'relaxing' },
        { id: 'mode-zen', name: 'Digital Zen', tier: 'Abstract', category: 'abstract' }
      ];

      const defaultSettings = {
        selectedMode: 'mode-minimal',
        clockEnabled: true,
        clock24h: true,
        clockSeconds: false,
        clockDate: true,
        clockOpacity: 45,
        brightness: 100,
        wakeLockEnabled: true,
        burnInEnabled: true,
        burnInInterval: 2, // minutes
        mountainPalette: 'midnight',
        autoFullscreen: false,
        autoCycle: 0, // minutes (0 = off)
        soundEnabled: false
      };

      let settings = Object.assign({}, defaultSettings);

      function loadSettings() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            settings = Object.assign({}, defaultSettings, parsed);
          }
        } catch (e) {
          console.warn('[Awaken] Could not access localStorage, using defaults.', e);
        }
      }

      function saveSettings() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
        } catch (e) {
          console.warn('[Awaken] Could not save to localStorage.', e);
        }
      }

      // App runtime state
      const appState = {
        isScreensaverActive: false,
        isPaused: false,
        wakeLockSentinel: null,
        wakeLockSupported: 'wakeLock' in navigator && (window.isSecureContext || location.hostname === 'localhost'),
        activeModeIndex: 0,
        hudTimeoutId: null,
        clockIntervalId: null,
        burnInIntervalId: null,
        autoCycleIntervalId: null,
        audioContext: null,
        audioGainNode: null,
        activeSoundSource: null
      };

      // DOM Elements cache
      const DOM = {
        dashboardView: document.getElementById('dashboard-view'),
        viewport: document.getElementById('screensaver-viewport'),
        dimmer: document.getElementById('screensaver-dimmer'),
        clockContainer: document.getElementById('screensaver-clock-container'),
        hudClockTime: document.getElementById('hud-time-main'),
        hudClockSec: document.getElementById('hud-time-sec'),
        hudClockDate: document.getElementById('hud-clock-date'),
        minimalClockTime: document.getElementById('minimal-clock-time'),
        minimalClockDate: document.getElementById('minimal-clock-date'),
        minimalDisplay: document.getElementById('mode-minimal-display'),
        screensaverHud: document.getElementById('screensaver-hud'),
        pauseBadge: document.getElementById('screensaver-pause-badge'),
        hudModeName: document.getElementById('hud-current-mode-name'),
        hudDimmerSlider: document.getElementById('hud-dimmer-slider'),
        startBtn: document.getElementById('start-screensaver-btn'),
        fullscreenBtn: document.getElementById('fullscreen-btn'),
        settingsBtn: document.getElementById('settings-btn'),
        settingsModal: document.getElementById('settings-modal'),
        closeSettingsBtn: document.getElementById('close-settings-btn'),
        saveSettingsBtn: document.getElementById('save-settings-btn'),
        resetSettingsBtn: document.getElementById('reset-settings-btn'),
        wakelockPill: document.getElementById('wakelock-pill'),
        wakelockDot: document.getElementById('wakelock-dot'),
        wakelockText: document.getElementById('wakelock-text'),
        hudWakeLockBtn: document.getElementById('hud-wakelock-btn'),
        hudWakeLockText: document.getElementById('hud-wakelock-text'),
        hudMountainBtn: document.getElementById('hud-mountain-btn'),
        hudMountainText: document.getElementById('hud-mountain-text'),
        hudSoundBtn: document.getElementById('hud-sound-btn'),
        hudSoundText: document.getElementById('hud-sound-text'),
        hudExitBtn: document.getElementById('hud-exit-btn'),
        hudPrevBtn: document.getElementById('hud-prev-mode'),
        hudNextBtn: document.getElementById('hud-next-mode'),
        modeCards: document.querySelectorAll('.mode-card'),
        filterTabs: document.querySelectorAll('.filter-tab'),
        statSelectedMode: document.getElementById('stat-selected-mode'),
        statBurninVal: document.getElementById('stat-burnin-val'),
        statLockVal: document.getElementById('stat-lock-val'),
        mountainsWrapper: document.getElementById('mountains-wrapper'),
        // Setting form fields
        settingClockEnable: document.getElementById('setting-clock-enable'),
        settingClock24h: document.getElementById('setting-clock-24h'),
        settingClockSeconds: document.getElementById('setting-clock-seconds'),
        settingClockDate: document.getElementById('setting-clock-date'),
        settingClockOpacity: document.getElementById('setting-clock-opacity'),
        settingClockOpacityVal: document.getElementById('setting-clock-opacity-val'),
        settingBrightness: document.getElementById('setting-brightness'),
        settingBrightnessVal: document.getElementById('setting-brightness-val'),
        settingWakeLockEnable: document.getElementById('setting-wakelock-enable'),
        settingBurnInEnable: document.getElementById('setting-burnin-enable'),
        settingBurnInInterval: document.getElementById('setting-burnin-interval'),
        settingMountainPalette: document.getElementById('setting-mountain-palette'),
        settingAutoCycle: document.getElementById('setting-autocycle'),
        settingAutoFullscreen: document.getElementById('setting-auto-fullscreen'),
        settingSoundEnable: document.getElementById('setting-sound-enable')
      };

      // =======================================================================
      // 2. ESSENTIAL SCREEN WAKE LOCK SYSTEM
      // =======================================================================
      const WakeLockSystem = {
        async requestLock() {
          if (!settings.wakeLockEnabled) return false;
          if (!appState.wakeLockSupported) {
            this.updateUIStatus('unsupported');
            return false;
          }
          if (appState.wakeLockSentinel !== null) {
            return true; // Already acquired
          }

          try {
            appState.wakeLockSentinel = await navigator.wakeLock.request('screen');
            appState.wakeLockSentinel.addEventListener('release', () => {
              appState.wakeLockSentinel = null;
              this.updateUIStatus('released');
            });
            this.updateUIStatus('active');
            return true;
          } catch (err) {
            console.warn('[WakeLock] Request failed:', err.name, err.message);
            this.updateUIStatus('error');
            return false;
          }
        },

        async releaseLock() {
          if (appState.wakeLockSentinel) {
            try {
              await appState.wakeLockSentinel.release();
            } catch (err) {
              console.warn('[WakeLock] Release error:', err);
            }
            appState.wakeLockSentinel = null;
          }
          this.updateUIStatus('inactive');
        },

        async toggleManual() {
          settings.wakeLockEnabled = !settings.wakeLockEnabled;
          saveSettings();
          DOM.settingWakeLockEnable.checked = settings.wakeLockEnabled;
          if (settings.wakeLockEnabled) {
            await this.requestLock();
          } else {
            await this.releaseLock();
          }
        },

        updateUIStatus(status) {
          if (!appState.wakeLockSupported) {
            DOM.wakelockDot.className = 'status-dot blocked';
            DOM.wakelockText.textContent = 'Wake Lock: N/A';
            DOM.statLockVal.textContent = 'Unsupported';
            DOM.statLockVal.style.color = 'var(--text-muted)';
            if (DOM.hudWakeLockBtn) {
              DOM.hudWakeLockBtn.classList.remove('active');
              DOM.hudWakeLockText.textContent = 'No Lock';
            }
            return;
          }

          if (appState.wakeLockSentinel !== null || status === 'active') {
            DOM.wakelockDot.className = 'status-dot active';
            DOM.wakelockText.textContent = 'Wake Lock: Active';
            DOM.statLockVal.textContent = 'Active (Protected)';
            DOM.statLockVal.style.color = 'var(--accent-emerald)';
            if (DOM.hudWakeLockBtn) {
              DOM.hudWakeLockBtn.classList.add('active');
              DOM.hudWakeLockText.textContent = 'Awake';
            }
          } else {
            DOM.wakelockDot.className = 'status-dot';
            DOM.wakelockText.textContent = settings.wakeLockEnabled ? 'Wake Lock: Idle' : 'Wake Lock: Disabled';
            DOM.statLockVal.textContent = settings.wakeLockEnabled ? 'Ready' : 'Disabled';
            DOM.statLockVal.style.color = 'var(--accent-cyan)';
            if (DOM.hudWakeLockBtn) {
              DOM.hudWakeLockBtn.classList.remove('active');
              DOM.hudWakeLockText.textContent = 'Off';
            }
          }
        },

        handleVisibilityChange() {
          if (document.visibilityState === 'visible' && appState.isScreensaverActive && settings.wakeLockEnabled) {
            this.requestLock();
          }
        }
      };

      // =======================================================================
      // 3. OLED BURN-IN PROTECTION & POSITION SHIFTING
      // =======================================================================
      const OLEDSystem = {
        zones: [
          { top: '15%', left: '15%' },
          { top: '15%', left: '50%' },
          { top: '15%', left: '80%' },
          { top: '50%', left: '20%' },
          { top: '50%', left: '50%' },
          { top: '50%', left: '80%' },
          { top: '80%', left: '20%' },
          { top: '80%', left: '50%' },
          { top: '80%', left: '80%' }
        ],
        currentZoneIdx: 4,

        start() {
          this.stop();
          if (!settings.burnInEnabled) {
            DOM.statBurninVal.textContent = 'Disabled';
            DOM.statBurninVal.style.color = 'var(--text-muted)';
            return;
          }
          DOM.statBurninVal.textContent = 'Active';
          DOM.statBurninVal.style.color = 'var(--accent-emerald)';

          const intervalMs = Math.max(1, settings.burnInInterval) * 60 * 1000;
          appState.burnInIntervalId = setInterval(() => {
            this.shiftElements();
          }, intervalMs);
          this.shiftElements();
        },

        stop() {
          if (appState.burnInIntervalId) {
            clearInterval(appState.burnInIntervalId);
            appState.burnInIntervalId = null;
          }
        },

        shiftElements() {
          // 1. Shift Mode 1 minimal readout across safe 9-zone boundary
          this.currentZoneIdx = (this.currentZoneIdx + 1) % this.zones.length;
          const targetZone = this.zones[this.currentZoneIdx];
          
          if (DOM.minimalDisplay) {
            DOM.minimalDisplay.style.top = targetZone.top;
            DOM.minimalDisplay.style.left = targetZone.left;
            DOM.minimalDisplay.style.transform = 'translate(-50%, -50%)';
          }

          // 2. Micro-shift HUD overlay clock within +/- 30px
          if (DOM.clockContainer) {
            const rx = (Math.random() * 40 - 20).toFixed(1);
            const ry = (Math.random() * 30 - 15).toFixed(1);
            DOM.clockContainer.style.transform = `translate(calc(-50% + ${rx}px), calc(-50% + ${ry}px))`;
          }
        }
      };

      // =======================================================================
      // 4. CLOCK & TELEMETRY ENGINE
      // =======================================================================
      const ClockEngine = {
        start() {
          this.stop();
          this.updateClock();

          // In Mode 1 (Ultra Low Resource), align strictly to 60-second boundaries
          const activeMode = MODES[appState.activeModeIndex];
          if (activeMode.id === 'mode-minimal') {
            const now = new Date();
            const delayToNextMinute = (60 - now.getSeconds()) * 1000;
            appState.clockIntervalId = setTimeout(() => {
              this.updateClock();
              appState.clockIntervalId = setInterval(() => this.updateClock(), 60000);
            }, delayToNextMinute);
          } else {
            // Animated modes: update every 1000ms (or 500ms if seconds shown)
            const interval = settings.clockSeconds ? 500 : 1000;
            appState.clockIntervalId = setInterval(() => this.updateClock(), interval);
          }
        },

        stop() {
          if (appState.clockIntervalId) {
            clearInterval(appState.clockIntervalId);
            clearTimeout(appState.clockIntervalId);
            appState.clockIntervalId = null;
          }
        },

        updateClock() {
          const now = new Date();
          let hours = now.getHours();
          const minutes = String(now.getMinutes()).padStart(2, '0');
          const seconds = String(now.getSeconds()).padStart(2, '0');
          
          let ampm = '';
          if (!settings.clock24h) {
            ampm = hours >= 12 ? ' PM' : ' AM';
            hours = hours % 12 || 12;
          }
          const hoursStr = String(hours).padStart(2, '0');
          const timeMain = `${hoursStr}:${minutes}${ampm}`;

          // Format Date
          const options = { weekday: 'short', month: 'short', day: 'numeric' };
          const dateStr = now.toLocaleDateString(undefined, options);

          // Update HUD clock
          if (DOM.hudClockTime) {
            DOM.hudClockTime.textContent = timeMain;
            if (settings.clockSeconds) {
              DOM.hudClockSec.textContent = `:${seconds}`;
              DOM.hudClockSec.style.display = 'inline';
            } else {
              DOM.hudClockSec.style.display = 'none';
            }
          }
          if (DOM.hudClockDate) {
            DOM.hudClockDate.textContent = dateStr;
            DOM.hudClockDate.style.display = settings.clockDate ? 'block' : 'none';
          }

          // Update Mode 1 Minimal Display
          if (DOM.minimalClockTime) DOM.minimalClockTime.textContent = timeMain;
          if (DOM.minimalClockDate) {
            DOM.minimalClockDate.textContent = dateStr;
            DOM.minimalClockDate.style.display = settings.clockDate ? 'block' : 'none';
          }
        }
      };

      // =======================================================================
      // 5. AUDIO SYNTHESIS ENGINE (ZERO ASSETS, 100% WEB AUDIO)
      // =======================================================================
      const AudioEngine = {
        init() {
          if (appState.audioContext) return;
          try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) {
              appState.audioContext = new AudioCtx();
              appState.audioGainNode = appState.audioContext.createGain();
              appState.audioGainNode.gain.setValueAtTime(0.15, appState.audioContext.currentTime);
              appState.audioGainNode.connect(appState.audioContext.destination);
            }
          } catch (e) {
            console.warn('[AudioEngine] Web Audio not available', e);
          }
        },

        playModeAudio(modeId) {
          this.stop();
          if (!settings.soundEnabled || !appState.audioContext) return;
          if (appState.audioContext.state === 'suspended') {
            appState.audioContext.resume();
          }

          // Generate procedural soundscape matching active mode
          try {
            const ctx = appState.audioContext;
            const now = ctx.currentTime;

            if (modeId === 'mode-rain') {
              // Pink noise rain synthesis
              const bufferSize = ctx.sampleRate * 2;
              const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
              const data = buffer.getChannelData(0);
              let b0 = 0, b1 = 0, b2 = 0;
              for (let i = 0; i < bufferSize; i++) {
                const white = Math.random() * 2 - 1;
                b0 = 0.99886 * b0 + white * 0.0555179;
                b1 = 0.99332 * b1 + white * 0.0750759;
                b2 = 0.96900 * b2 + white * 0.1538520;
                data[i] = (b0 + b1 + b2) * 0.12;
              }
              const noiseSource = ctx.createBufferSource();
              noiseSource.buffer = buffer;
              noiseSource.loop = true;

              const filter = ctx.createBiquadFilter();
              filter.type = 'lowpass';
              filter.frequency.setValueAtTime(900, now);

              noiseSource.connect(filter);
              filter.connect(appState.audioGainNode);
              noiseSource.start();
              appState.activeSoundSource = noiseSource;

            } else if (modeId === 'mode-space' || modeId === 'mode-zen') {
              // Ethereal binaural cosmic sine tone (432Hz ambient drone)
              const osc = ctx.createOscillator();
              osc.type = 'sine';
              osc.frequency.setValueAtTime(108, now); // low octave harmonic

              const lfo = ctx.createOscillator();
              lfo.frequency.setValueAtTime(0.2, now); // slow breathing sweep
              const lfoGain = ctx.createGain();
              lfoGain.gain.setValueAtTime(15, now);
              lfo.connect(osc.frequency);
              lfo.start();

              osc.connect(appState.audioGainNode);
              osc.start();
              appState.activeSoundSource = osc;

            } else if (modeId === 'mode-fireplace') {
              // Fireplace warm low rumble + crackle
              const osc = ctx.createOscillator();
              osc.type = 'triangle';
              osc.frequency.setValueAtTime(65, now);
              osc.connect(appState.audioGainNode);
              osc.start();
              appState.activeSoundSource = osc;
            }
          } catch (e) {
            console.warn('[AudioEngine] Sound generation failed', e);
          }
        },

        stop() {
          if (appState.activeSoundSource) {
            try {
              appState.activeSoundSource.stop();
              appState.activeSoundSource.disconnect();
            } catch (e) {}
            appState.activeSoundSource = null;
          }
        },

        toggle() {
          settings.soundEnabled = !settings.soundEnabled;
          saveSettings();
          DOM.settingSoundEnable.checked = settings.soundEnabled;
          if (settings.soundEnabled) {
            this.init();
            const activeMode = MODES[appState.activeModeIndex];
            this.playModeAudio(activeMode.id);
            DOM.hudSoundBtn.classList.add('active');
            DOM.hudSoundText.textContent = 'Sound On';
          } else {
            this.stop();
            DOM.hudSoundBtn.classList.remove('active');
            DOM.hudSoundText.textContent = 'Muted';
          }
        }
      };

      // =======================================================================
      // 6. PROCEDURAL CANVAS ENGINES (CAPPED & PAUSEABLE)
      // =======================================================================
      
      // Rain Canvas Engine (Mode 3)
      const RainEngine = {
        canvas: document.getElementById('rain-canvas'),
        ctx: null,
        drops: [],
        rafId: null,
        lightningTimer: null,
        running: false,

        init() {
          if (!this.canvas) return;
          this.ctx = this.canvas.getContext('2d');
          this.resize();
          this.drops = [];
          const count = Math.min(38, Math.floor(window.innerWidth / 35));
          for (let i = 0; i < count; i++) {
            this.drops.push({
              x: Math.random() * this.canvas.width,
              y: Math.random() * this.canvas.height,
              len: Math.random() * 22 + 15,
              speed: Math.random() * 5 + 3,
              opacity: Math.random() * 0.4 + 0.2
            });
          }
        },

        resize() {
          if (!this.canvas) return;
          this.canvas.width = window.innerWidth;
          this.canvas.height = window.innerHeight;
        },

        start() {
          this.init();
          this.running = true;
          this.startLightning();
          const render = () => {
            if (!this.running || appState.isPaused) return;
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
            this.ctx.strokeStyle = 'rgba(210, 235, 255, 0.45)';
            this.ctx.lineWidth = 1.2;

            for (let i = 0; i < this.drops.length; i++) {
              const d = this.drops[i];
              this.ctx.beginPath();
              this.ctx.moveTo(d.x, d.y);
              this.ctx.lineTo(d.x - 2, d.y + d.len);
              this.ctx.stroke();

              d.y += d.speed;
              d.x -= 0.5;
              if (d.y > this.canvas.height) {
                d.y = -d.len;
                d.x = Math.random() * this.canvas.width;
              }
            }
            this.rafId = requestAnimationFrame(render);
          };
          this.rafId = requestAnimationFrame(render);
        },

        startLightning() {
          const flash = () => {
            if (!this.running || appState.isPaused) return;
            const el = document.getElementById('rain-lightning');
            if (el) {
              el.style.opacity = '0.35';
              setTimeout(() => {
                el.style.opacity = '0';
                if (Math.random() > 0.6) {
                  setTimeout(() => {
                    el.style.opacity = '0.22';
                    setTimeout(() => { el.style.opacity = '0'; }, 80);
                  }, 120);
                }
              }, 100);
            }
            const nextDelay = (Math.random() * 16 + 14) * 1000;
            this.lightningTimer = setTimeout(flash, nextDelay);
          };
          this.lightningTimer = setTimeout(flash, 6000);
        },

        stop() {
          this.running = false;
          if (this.rafId) {
            cancelAnimationFrame(this.rafId);
            this.rafId = null;
          }
          if (this.lightningTimer) {
            clearTimeout(this.lightningTimer);
            this.lightningTimer = null;
          }
          if (this.ctx && this.canvas) {
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
          }
        }
      };

      // Space Stars Canvas Engine (Mode 4)
      const SpaceEngine = {
        canvas: document.getElementById('space-stars-canvas'),
        ctx: null,
        stars: [],
        rafId: null,
        shootingStarTimer: null,
        running: false,

        init() {
          if (!this.canvas) return;
          this.ctx = this.canvas.getContext('2d');
          this.canvas.width = window.innerWidth;
          this.canvas.height = window.innerHeight;
          this.stars = [];
          const count = Math.min(85, Math.floor(window.innerWidth / 18));
          for (let i = 0; i < count; i++) {
            this.stars.push({
              x: Math.random() * this.canvas.width,
              y: Math.random() * this.canvas.height,
              size: Math.random() * 1.8 + 0.4,
              opacity: Math.random() * 0.8 + 0.2,
              drift: Math.random() * 0.12 + 0.03
            });
          }
        },

        start() {
          this.init();
          this.running = true;
          this.startShootingStars();
          const render = () => {
            if (!this.running || appState.isPaused) return;
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

            for (let i = 0; i < this.stars.length; i++) {
              const s = this.stars[i];
              this.ctx.fillStyle = `rgba(255, 255, 255, ${s.opacity})`;
              this.ctx.beginPath();
              this.ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
              this.ctx.fill();

              s.y -= s.drift;
              if (s.y < 0) {
                s.y = this.canvas.height;
                s.x = Math.random() * this.canvas.width;
              }
            }
            this.rafId = requestAnimationFrame(render);
          };
          this.rafId = requestAnimationFrame(render);
        },

        startShootingStars() {
          const shoot = () => {
            if (!this.running || appState.isPaused) return;
            const star = document.getElementById('space-shooting-star');
            if (star) {
              const startX = Math.random() * (window.innerWidth * 0.7);
              const startY = Math.random() * (window.innerHeight * 0.35);
              star.style.left = startX + 'px';
              star.style.top = startY + 'px';
              star.style.width = '140px';
              star.style.opacity = '0.9';
              star.style.transform = 'rotate(-32deg) translateX(0)';
              star.style.transition = 'none';

              requestAnimationFrame(() => {
                star.style.transition = 'transform 1.2s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 1.2s ease';
                star.style.transform = 'rotate(-32deg) translateX(360px)';
                star.style.opacity = '0';
              });
            }
            const nextDelay = (Math.random() * 9 + 8) * 1000;
            this.shootingStarTimer = setTimeout(shoot, nextDelay);
          };
          this.shootingStarTimer = setTimeout(shoot, 3000);
        },

        stop() {
          this.running = false;
          if (this.rafId) {
            cancelAnimationFrame(this.rafId);
            this.rafId = null;
          }
          if (this.shootingStarTimer) {
            clearTimeout(this.shootingStarTimer);
            this.shootingStarTimer = null;
          }
        }
      };

      // Cyberpunk Flying Vehicles Engine (Mode 6)
      const CyberEngine = {
        spinnerTimer: null,
        start() {
          this.stop();
          const spawn = () => {
            if (appState.isPaused) return;
            const el = document.getElementById('cyber-spinner-car');
            if (el) {
              const startY = Math.random() * (window.innerHeight * 0.35) + 50;
              const duration = (Math.random() * 3 + 6);
              el.style.top = `${startY}px`;
              el.style.left = '-80px';
              el.style.opacity = '1';
              el.style.transition = 'none';

              requestAnimationFrame(() => {
                el.style.transition = `left ${duration}s linear, opacity 0.6s ease ${duration - 0.6}s`;
                el.style.left = `${window.innerWidth + 80}px`;
                setTimeout(() => { el.style.opacity = '0'; }, (duration - 0.6) * 1000);
              });
            }
            const nextDelay = (Math.random() * 6 + 7) * 1000;
            this.spinnerTimer = setTimeout(spawn, nextDelay);
          };
          this.spinnerTimer = setTimeout(spawn, 2000);
        },
        stop() {
          if (this.spinnerTimer) {
            clearTimeout(this.spinnerTimer);
            this.spinnerTimer = null;
          }
        }
      };

      // Cabin Snow Canvas Engine (Mode 7)
      const SnowEngine = {
        canvas: document.getElementById('snow-canvas'),
        ctx: null,
        flakes: [],
        rafId: null,
        running: false,

        init() {
          if (!this.canvas) return;
          this.ctx = this.canvas.getContext('2d');
          this.canvas.width = this.canvas.offsetWidth || 180;
          this.canvas.height = this.canvas.offsetHeight || 220;
          this.flakes = [];
          for (let i = 0; i < 35; i++) {
            this.flakes.push({
              x: Math.random() * this.canvas.width,
              y: Math.random() * this.canvas.height,
              r: Math.random() * 1.8 + 0.8,
              speed: Math.random() * 0.8 + 0.4,
              sway: Math.random() * 1.2
            });
          }
        },

        start() {
          this.init();
          this.running = true;
          const render = () => {
            if (!this.running || appState.isPaused) return;
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
            this.ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';

            for (let i = 0; i < this.flakes.length; i++) {
              const f = this.flakes[i];
              this.ctx.beginPath();
              this.ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
              this.ctx.fill();

              f.y += f.speed;
              f.x += Math.sin(f.y * 0.05) * 0.3;
              if (f.y > this.canvas.height) {
                f.y = -5;
                f.x = Math.random() * this.canvas.width;
              }
            }
            this.rafId = requestAnimationFrame(render);
          };
          this.rafId = requestAnimationFrame(render);
        },

        stop() {
          this.running = false;
          if (this.rafId) {
            cancelAnimationFrame(this.rafId);
            this.rafId = null;
          }
        }
      };

      // =======================================================================
      // 7. MODE CONTROLLER & LIFECYCLE
      // =======================================================================
      const ModeController = {
        switchMode(newIndex) {
          if (newIndex < 0) newIndex = MODES.length - 1;
          if (newIndex >= MODES.length) newIndex = 0;

          // 1. Cleanup previous mode engine
          this.cleanupCurrentMode();

          appState.activeModeIndex = newIndex;
          const target = MODES[newIndex];
          settings.selectedMode = target.id;
          saveSettings();

          // 2. Update UI card selection
          DOM.modeCards.forEach(c => {
            if (c.getAttribute('data-mode-id') === target.id) {
              c.classList.add('selected');
            } else {
              c.classList.remove('selected');
            }
          });
          DOM.statSelectedMode.textContent = target.name.split(' ')[0];

          // 3. If screensaver is running, activate new scene immediately
          if (appState.isScreensaverActive) {
            this.activateScene(target.id);
            this.showHUD();
          }
        },

        activateScene(modeId) {
          // Hide all scene divs
          document.querySelectorAll('.screensaver-scene').forEach(sc => {
            sc.classList.remove('active-scene');
          });

          const activeEl = document.getElementById(modeId);
          if (activeEl) activeEl.classList.add('active-scene');

          // Update HUD info
          const current = MODES[appState.activeModeIndex];
          if (DOM.hudModeName) DOM.hudModeName.textContent = current.name;

          // Clock visibility rules
          if (modeId === 'mode-minimal') {
            DOM.clockContainer.style.display = 'none';
          } else {
            DOM.clockContainer.style.display = settings.clockEnabled ? 'flex' : 'none';
          }

          // Restart clock engine with mode-specific intervals
          ClockEngine.start();

          // Mode-specific initialization
          if (modeId === 'mode-rain') RainEngine.start();
          if (modeId === 'mode-space') SpaceEngine.start();
          if (modeId === 'mode-fireplace') SnowEngine.start();
          if (modeId === 'mode-cyberpunk') CyberEngine.start();
          if (modeId === 'mode-mountains') {
            DOM.mountainsWrapper.className = `mountains-scene theme-${settings.mountainPalette}`;
            if (DOM.hudMountainBtn) {
              DOM.hudMountainBtn.style.display = 'flex';
              DOM.hudMountainText.textContent = settings.mountainPalette.charAt(0).toUpperCase() + settings.mountainPalette.slice(1);
            }
          } else {
            if (DOM.hudMountainBtn) DOM.hudMountainBtn.style.display = 'none';
          }

          // Procedural Audio
          if (settings.soundEnabled) {
            AudioEngine.playModeAudio(modeId);
          }
        },

        cleanupCurrentMode() {
          RainEngine.stop();
          SpaceEngine.stop();
          SnowEngine.stop();
          CyberEngine.stop();
          AudioEngine.stop();
        },

        startScreensaver() {
          appState.isScreensaverActive = true;
          document.body.classList.add('screensaver-active');
          DOM.viewport.classList.add('active');

          // Handle Fullscreen if requested
          if (settings.autoFullscreen) {
            this.requestFullscreen();
          }

          // Request wake lock
          WakeLockSystem.requestLock();

          // Activate chosen mode
          const idx = MODES.findIndex(m => m.id === settings.selectedMode);
          appState.activeModeIndex = idx >= 0 ? idx : 0;
          this.activateScene(MODES[appState.activeModeIndex].id);

          // Start OLED Care
          OLEDSystem.start();

          // Apply visual brightness
          this.applyBrightness(settings.brightness);

          // Setup Auto-cycle if configured
          this.setupAutoCycle();

          // Show HUD briefly on startup
          this.showHUD();
        },

        exitScreensaver() {
          appState.isScreensaverActive = false;
          document.body.classList.remove('screensaver-active', 'hide-cursor');
          DOM.viewport.classList.remove('active');

          // Cleanup active scene engines
          this.cleanupCurrentMode();
          ClockEngine.stop();
          OLEDSystem.stop();

          if (appState.autoCycleIntervalId) {
            clearInterval(appState.autoCycleIntervalId);
            appState.autoCycleIntervalId = null;
          }

          // Release wake lock
          WakeLockSystem.releaseLock();

          // Exit fullscreen if active
          if (document.fullscreenElement) {
            document.exitFullscreen().catch(() => {});
          }
        },

        togglePause() {
          appState.isPaused = !appState.isPaused;
          DOM.pauseBadge.classList.toggle('visible', appState.isPaused);
          if (appState.isPaused) {
            RainEngine.stop();
            SpaceEngine.stop();
            SnowEngine.stop();
          } else {
            const activeMode = MODES[appState.activeModeIndex];
            if (activeMode.id === 'mode-rain') RainEngine.start();
            if (activeMode.id === 'mode-space') SpaceEngine.start();
            if (activeMode.id === 'mode-fireplace') SnowEngine.start();
          }
        },

        showHUD() {
          if (!appState.isScreensaverActive) return;
          DOM.screensaverHud.classList.add('visible');
          document.body.classList.remove('hide-cursor');

          if (appState.hudTimeoutId) clearTimeout(appState.hudTimeoutId);
          appState.hudTimeoutId = setTimeout(() => {
            DOM.screensaverHud.classList.remove('visible');
            document.body.classList.add('hide-cursor');
          }, 3200);
        },

        applyBrightness(level) {
          settings.brightness = level;
          const factor = Math.max(0.15, level / 100);
          document.documentElement.style.setProperty('--screensaver-brightness', factor);
          if (DOM.dimmer) {
            DOM.dimmer.style.opacity = (1 - factor).toFixed(2);
          }
          if (DOM.hudDimmerSlider) DOM.hudDimmerSlider.value = level;
          if (DOM.settingBrightness) DOM.settingBrightness.value = level;
          if (DOM.settingBrightnessVal) DOM.settingBrightnessVal.textContent = `${level}%`;
        },

        applyClockOpacity(opacity) {
          settings.clockOpacity = opacity;
          const factor = (opacity / 100).toFixed(2);
          document.documentElement.style.setProperty('--clock-opacity', factor);
          if (DOM.settingClockOpacityVal) DOM.settingClockOpacityVal.textContent = `${opacity}%`;
        },

        requestFullscreen() {
          const docEl = document.documentElement;
          if (docEl.requestFullscreen) {
            docEl.requestFullscreen().catch(() => {});
          }
        },

        setupAutoCycle() {
          if (appState.autoCycleIntervalId) {
            clearInterval(appState.autoCycleIntervalId);
            appState.autoCycleIntervalId = null;
          }
          const mins = parseInt(settings.autoCycle, 10);
          if (mins > 0) {
            appState.autoCycleIntervalId = setInterval(() => {
              this.switchMode(appState.activeModeIndex + 1);
            }, mins * 60 * 1000);
          }
        }
      };

      // =======================================================================
      // 8. EVENT HANDLERS & USER INTERACTION
      // =======================================================================
      function setupEventListeners() {
        // Mode Selection Grid clicks
        DOM.modeCards.forEach((card, index) => {
          card.addEventListener('click', () => {
            ModeController.switchMode(index);
          });
        });

        // Category Filter Tabs
        DOM.filterTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            DOM.filterTabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            const category = tab.getAttribute('data-filter');
            DOM.modeCards.forEach(card => {
              if (category === 'all' || card.getAttribute('data-category') === category) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          });
        });

        // Start Screensaver Button
        DOM.startBtn.addEventListener('click', () => {
          ModeController.startScreensaver();
        });

        // Wake Lock Pill Toggle
        DOM.wakelockPill.addEventListener('click', () => {
          WakeLockSystem.toggleManual();
        });
        DOM.hudWakeLockBtn.addEventListener('click', () => {
          WakeLockSystem.toggleManual();
        });

        // Fullscreen Toggle
        DOM.fullscreenBtn.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            ModeController.requestFullscreen();
          } else {
            document.exitFullscreen().catch(() => {});
          }
        });

        // Mountain Theme Cycler
        if (DOM.hudMountainBtn) {
          DOM.hudMountainBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const palettes = ['midnight', 'sunset', 'winter'];
            let nextIdx = (palettes.indexOf(settings.mountainPalette) + 1) % palettes.length;
            settings.mountainPalette = palettes[nextIdx];
            saveSettings();
            if (DOM.mountainsWrapper) {
              DOM.mountainsWrapper.className = `mountains-scene theme-${settings.mountainPalette}`;
            }
            if (DOM.settingMountainPalette) {
              DOM.settingMountainPalette.value = settings.mountainPalette;
            }
            DOM.hudMountainText.textContent = settings.mountainPalette.charAt(0).toUpperCase() + settings.mountainPalette.slice(1);
          });
        }

        // Sound Toggle
        DOM.hudSoundBtn.addEventListener('click', () => {
          AudioEngine.toggle();
        });

        // HUD Prev / Next Mode Arrows
        DOM.hudPrevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          ModeController.switchMode(appState.activeModeIndex - 1);
        });
        DOM.hudNextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          ModeController.switchMode(appState.activeModeIndex + 1);
        });

        // In-Screensaver Dimmer Slider
        DOM.hudDimmerSlider.addEventListener('input', (e) => {
          ModeController.applyBrightness(parseInt(e.target.value, 10));
        });

        // Exit Screensaver Button
        DOM.hudExitBtn.addEventListener('click', () => {
          ModeController.exitScreensaver();
        });

        // Mouse & Touch interaction during Screensaver (Auto-reveal HUD)
        window.addEventListener('mousemove', () => {
          if (appState.isScreensaverActive) ModeController.showHUD();
        });
        window.addEventListener('touchstart', () => {
          if (appState.isScreensaverActive) ModeController.showHUD();
        });
        DOM.viewport.addEventListener('click', (e) => {
          if (e.target.closest('#screensaver-hud')) return;
          ModeController.showHUD();
        });
        DOM.viewport.addEventListener('dblclick', (e) => {
          if (e.target.closest('#screensaver-hud')) return;
          ModeController.exitScreensaver();
        });

        // Keyboard Shortcuts
        window.addEventListener('keydown', (e) => {
          // If modal is open, let Esc close it
          if (DOM.settingsModal.classList.contains('open')) {
            if (e.key === 'Escape') closeSettingsModal();
            return;
          }

          if (appState.isScreensaverActive) {
            switch (e.key) {
              case 'Escape':
                e.preventDefault();
                ModeController.exitScreensaver();
                break;
              case ' ':
                e.preventDefault();
                ModeController.togglePause();
                break;
              case 'ArrowLeft':
                e.preventDefault();
                ModeController.switchMode(appState.activeModeIndex - 1);
                break;
              case 'ArrowRight':
                e.preventDefault();
                ModeController.switchMode(appState.activeModeIndex + 1);
                break;
              case 'ArrowUp':
                e.preventDefault();
                ModeController.applyBrightness(Math.min(100, settings.brightness + 10));
                break;
              case 'ArrowDown':
                e.preventDefault();
                ModeController.applyBrightness(Math.max(15, settings.brightness - 10));
                break;
              case 'f':
              case 'F':
                if (!document.fullscreenElement) ModeController.requestFullscreen();
                else document.exitFullscreen().catch(() => {});
                break;
              case 'c':
              case 'C':
                settings.clockEnabled = !settings.clockEnabled;
                DOM.clockContainer.style.display = settings.clockEnabled ? 'flex' : 'none';
                DOM.settingClockEnable.checked = settings.clockEnabled;
                saveSettings();
                break;
              case 'm':
              case 'M':
                AudioEngine.toggle();
                break;
            }
          } else {
            // Dashboard shortcuts
            if (e.key === 'Enter' || e.key === ' ') {
              if (document.activeElement.tagName !== 'BUTTON' && document.activeElement.tagName !== 'INPUT') {
                e.preventDefault();
                ModeController.startScreensaver();
              }
            } else if (e.key === 's' || e.key === 'S') {
              openSettingsModal();
            } else if (e.key === 'f' || e.key === 'F') {
              if (!document.fullscreenElement) ModeController.requestFullscreen();
            }
          }
        });

        // Page Visibility API (Pause background animations and reclaim wake lock)
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            // Save battery: stop animation canvas
            RainEngine.stop();
            SpaceEngine.stop();
            SnowEngine.stop();
          } else {
            WakeLockSystem.handleVisibilityChange();
            if (appState.isScreensaverActive && !appState.isPaused) {
              const active = MODES[appState.activeModeIndex];
              if (active.id === 'mode-rain') RainEngine.start();
              if (active.id === 'mode-space') SpaceEngine.start();
              if (active.id === 'mode-fireplace') SnowEngine.start();
            }
          }
        });

        // Resize handler for Canvas elements
        window.addEventListener('resize', () => {
          if (appState.isScreensaverActive) {
            RainEngine.resize();
            SpaceEngine.init();
          }
        });

        // Settings Modal Open / Close
        DOM.settingsBtn.addEventListener('click', openSettingsModal);
        DOM.closeSettingsBtn.addEventListener('click', closeSettingsModal);
        DOM.settingsModal.addEventListener('click', (e) => {
          if (e.target === DOM.settingsModal) closeSettingsModal();
        });

        // Settings Form Controls Binding
        DOM.settingClockEnable.addEventListener('change', (e) => {
          settings.clockEnabled = e.target.checked;
        });
        DOM.settingClock24h.addEventListener('change', (e) => {
          settings.clock24h = e.target.checked;
          ClockEngine.updateClock();
        });
        DOM.settingClockSeconds.addEventListener('change', (e) => {
          settings.clockSeconds = e.target.checked;
          ClockEngine.start();
        });
        DOM.settingClockDate.addEventListener('change', (e) => {
          settings.clockDate = e.target.checked;
          ClockEngine.updateClock();
        });
        DOM.settingClockOpacity.addEventListener('input', (e) => {
          ModeController.applyClockOpacity(parseInt(e.target.value, 10));
        });
        DOM.settingBrightness.addEventListener('input', (e) => {
          ModeController.applyBrightness(parseInt(e.target.value, 10));
        });
        DOM.settingWakeLockEnable.addEventListener('change', (e) => {
          settings.wakeLockEnabled = e.target.checked;
          WakeLockSystem.updateUIStatus(settings.wakeLockEnabled ? 'idle' : 'inactive');
        });
        DOM.settingBurnInEnable.addEventListener('change', (e) => {
          settings.burnInEnabled = e.target.checked;
        });
        DOM.settingBurnInInterval.addEventListener('change', (e) => {
          settings.burnInInterval = parseInt(e.target.value, 10);
        });
        DOM.settingMountainPalette.addEventListener('change', (e) => {
          settings.mountainPalette = e.target.value;
          if (DOM.mountainsWrapper) {
            DOM.mountainsWrapper.className = `mountains-scene theme-${settings.mountainPalette}`;
          }
        });
        DOM.settingAutoCycle.addEventListener('change', (e) => {
          settings.autoCycle = parseInt(e.target.value, 10);
          ModeController.setupAutoCycle();
        });
        DOM.settingAutoFullscreen.addEventListener('change', (e) => {
          settings.autoFullscreen = e.target.checked;
        });
        DOM.settingSoundEnable.addEventListener('change', (e) => {
          if (e.target.checked !== settings.soundEnabled) {
            AudioEngine.toggle();
          }
        });

        DOM.saveSettingsBtn.addEventListener('click', () => {
          saveSettings();
          closeSettingsModal();
        });

        DOM.resetSettingsBtn.addEventListener('click', () => {
          settings = Object.assign({}, defaultSettings);
          saveSettings();
          syncSettingsToUI();
        });
      }

      function openSettingsModal() {
        syncSettingsToUI();
        DOM.settingsModal.classList.add('open');
      }

      function closeSettingsModal() {
        DOM.settingsModal.classList.remove('open');
      }

      function syncSettingsToUI() {
        DOM.settingClockEnable.checked = settings.clockEnabled;
        DOM.settingClock24h.checked = settings.clock24h;
        DOM.settingClockSeconds.checked = settings.clockSeconds;
        DOM.settingClockDate.checked = settings.clockDate;
        DOM.settingClockOpacity.value = settings.clockOpacity;
        DOM.settingClockOpacityVal.textContent = `${settings.clockOpacity}%`;
        DOM.settingBrightness.value = settings.brightness;
        DOM.settingBrightnessVal.textContent = `${settings.brightness}%`;
        DOM.settingWakeLockEnable.checked = settings.wakeLockEnabled;
        DOM.settingBurnInEnable.checked = settings.burnInEnabled;
        DOM.settingBurnInInterval.value = settings.burnInInterval;
        DOM.settingMountainPalette.value = settings.mountainPalette;
        DOM.settingAutoCycle.value = settings.autoCycle;
        DOM.settingAutoFullscreen.checked = settings.autoFullscreen;
        DOM.settingSoundEnable.checked = settings.soundEnabled;

        ModeController.applyClockOpacity(settings.clockOpacity);
        ModeController.applyBrightness(settings.brightness);
      }

      // Procedural City Skyline Generator for Mode 2
      function buildDriveCityBuildings() {
        const container = document.getElementById('drive-city-container');
        if (!container) return;
        container.innerHTML = '';
        for (let i = 0; i < 48; i++) {
          const bldg = document.createElement('div');
          bldg.className = 'drive-bldg';
          const w = Math.floor(Math.random() * 18 + 12);
          const h = Math.floor(Math.random() * 38 + 10);
          bldg.style.width = `${w}px`;
          bldg.style.height = `${h}px`;
          if (Math.random() > 0.4) {
            bldg.style.boxShadow = `inset 0 0 2px rgba(255, 255, 255, 0.2)`;
          }
          container.appendChild(bldg);
        }
      }

      // =======================================================================
      // 9. INITIALIZATION
      // =======================================================================
      function init() {
        loadSettings();
        buildDriveCityBuildings();
        setupEventListeners();
        syncSettingsToUI();
        WakeLockSystem.updateUIStatus('idle');

        // Select initial mode from storage
        const initialIdx = MODES.findIndex(m => m.id === settings.selectedMode);
        ModeController.switchMode(initialIdx >= 0 ? initialIdx : 0);

        console.info('[AWAKEN] Initialized successfully. 9 modes ready.');
      }

      // Boot application when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }

    })();
  </script>
</body>
</html>
